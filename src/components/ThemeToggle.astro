---
import Icon from '~/components/Icon.astro';
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-9 place-items-center rounded-lg border border-border text-muted transition-colors hover:bg-surface hover:text-fg"
  aria-label="Chuyển giao diện sáng/tối"
>
  {
    /* Cả hai icon cùng nằm trong DOM, CSS quyết định cái nào hiện. Nhờ vậy
      không có khoảnh khắc nào nút bị trống trong lúc JS chưa chạy. */
  }
  <Icon name="sun" size={18} class="hidden dark:block" />
  <Icon name="moon" size={18} class="block dark:hidden" />
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function syncPressedState() {
    button?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  }

  button?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      /* Chế độ riêng tư chặn localStorage — lựa chọn chỉ có hiệu lực trong phiên này. */
    }
    syncPressedState();
  });

  // Nếu người dùng chưa từng bấm nút, tiếp tục đi theo cài đặt của hệ điều hành.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (localStorage.getItem('theme')) return;
    root.classList.toggle('dark', event.matches);
    syncPressedState();
  });

  syncPressedState();
</script>
