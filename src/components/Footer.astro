---
import { SITE, AUTHOR, SOCIALS, NAV } from '~/site.config';
import Icon from '~/components/Icon.astro';
import type { IconName } from '~/lib/icons';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div class="wrap flex flex-col gap-8 py-12 sm:flex-row sm:justify-between">
    <div class="max-w-sm">
      <p class="font-bold">{SITE.title}</p>
      <p class="mt-2 text-sm text-muted">{AUTHOR.bio}</p>
    </div>

    {
      /* `flex-wrap` để hai cột tụt xuống nhau khi phóng chữ lớn, thay vì đẩy
        chân trang tràn ngang. */
    }
    <div class="flex flex-wrap gap-x-12 gap-y-8">
      <nav aria-label="Điều hướng chân trang">
        <p class="text-sm font-bold">Trang</p>
        <ul class="mt-3 space-y-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="tap py-1 text-sm text-muted transition-colors hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/rss.xml"
              class="tap py-1 text-sm text-muted transition-colors hover:text-accent"
            >
              RSS
            </a>
          </li>
        </ul>
      </nav>

      {
        SOCIALS.length > 0 && (
          <div>
            <p class="text-sm font-bold">Liên hệ</p>
            <ul class="mt-3 space-y-2">
              {SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    rel="me noopener"
                    class="tap gap-2 py-1 text-sm text-muted transition-colors hover:text-accent"
                  >
                    <Icon name={social.icon as IconName} size={16} />
                    {social.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  <div class="wrap border-t border-border py-6">
    <p class="text-sm text-muted">
      {`© ${year} ${AUTHOR.name}.`} Nội dung thuộc về tác giả, mã nguồn dùng giấy phép MIT.
    </p>
  </div>
</footer>
