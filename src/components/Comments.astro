---
import { ENV, commentsEnabled } from '~/env';

/**
 * Script đồng bộ sáng/tối cho iframe giscus, để dưới dạng CHUỖI rồi phát bằng
 * `set:html`. Ba ràng buộc gặp nhau ở đây, và mỗi cách khác đều vỡ một cái:
 *
 *  1. Phải chỉ xuất hiện khi giscus được bật. Để `<script>` ở cấp cao nhất của
 *     component thì Astro nâng nó lên và đóng gói vào MỌI trang bài — khoảng 250
 *     byte JS không bao giờ làm được gì, và chuỗi "giscus" vẫn nằm trong HTML của
 *     một site không có bình luận.
 *
 *  2. Không đặt được `<script>` CÓ THÂN trong biểu thức `{cond && (...)}`:
 *     prettier-plugin-astro không parse nổi và ném `SyntaxError: Unexpected
 *     token`. Đã làm CI đỏ một lần vì đúng chỗ này. Thẻ tự đóng như
 *     `<script src=… />` thì không sao — nó không có thân để parse.
 *
 *  3. `is:inline` là bắt buộc, nếu không Astro lại nâng script lên như ở (1).
 *
 * Chuỗi + `set:html` thoả cả ba: prettier chỉ thấy một template literal trong
 * frontmatter, còn thẻ trong template là thẻ tự đóng.
 */
const JS_DONG_BO_GIAO_DIEN = `
(() => {
  const FRAME_ORIGIN = 'https://giscus.app';

  function sendTheme() {
    const iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe || !iframe.contentWindow) return;

    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    iframe.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, FRAME_ORIGIN);
  }

  new MutationObserver(sendTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });

  window.addEventListener('message', (event) => {
    if (event.origin === FRAME_ORIGIN) sendTheme();
  });
})();
`;
---

{
  commentsEnabled && (
    <section class="mt-16 border-t border-border pt-10" aria-labelledby="comments-heading">
      <h2 id="comments-heading" class="text-xl font-bold tracking-tight">
        Bình luận
      </h2>
      <p class="mt-1 text-sm text-muted">
        Bình luận chạy trên GitHub Discussions — cần tài khoản GitHub để viết.
      </p>

      <div class="mt-6" id="giscus-container" />

      {/* giscus nằm trong iframe nên không nhận class `dark` của trang chủ. Cách
          duy nhất để đổi giao diện của nó là gửi message vào iframe. Xem chú thích
          ở `JS_DONG_BO_GIAO_DIEN` để biết vì sao nó là chuỗi. */}
      <script is:inline set:html={JS_DONG_BO_GIAO_DIEN} />

      {/*
        `is:inline` để Astro không gói script này vào bundle: giscus cần đúng thẻ
        script gốc với đầy đủ data-* thì mới tự khởi tạo được.
        `data-loading="lazy"` giữ cho iframe chưa tải tới khi người đọc cuộn
        xuống, nhờ vậy nó không kéo tụt điểm hiệu năng của trang.
      */}
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={ENV.giscusRepo}
        data-repo-id={ENV.giscusRepoId}
        data-category={ENV.giscusCategory}
        data-category-id={ENV.giscusCategoryId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="vi"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    </section>
  )
}
