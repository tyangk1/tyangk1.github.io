---
import { getPublishedPosts, collectTags } from '~/utils/posts';
import { searchPosts, type SearchHit } from '~/lib/post-live';
import { postHref } from '~/lib/routes';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import PostCard from '~/components/PostCard.astro';
import TagPill from '~/components/TagPill.astro';

/**
 * Một trang tìm kiếm chỉ có ô nhập là đường cùng: ai chưa biết blog có gì thì
 * không biết gõ từ nào. Nên dưới ô nhập luôn có sẵn chủ đề và bài mới nhất để
 * duyệt. Khối đó tự ẩn khi có truy vấn, tránh đứng chen với kết quả.
 */
export const prerender = false;

const posts = await getPublishedPosts();
const tags = collectTags(posts);
const baiMoi = posts.slice(0, 5);

/*
  Tìm kiếm chạy PHÍA MÁY CHỦ khi URL có `?q=`.

  Nghĩa là trang có kết quả ngay trong HTML đầu tiên: chạy được khi JS bị chặn, đọc được
  bằng screen reader không phải chờ vùng live, và một link `/search?q=cache` chia sẻ đi
  vẫn ra kết quả. Phần JS bên dưới chỉ thêm cảm giác tức thì, không phải điều kiện để
  trang hoạt động.
*/
const term = (Astro.url.searchParams.get('q') ?? '').trim();

let results: SearchHit[] = [];
let searchFailed = false;

if (term.length >= 2) {
  try {
    results = await searchPosts(term, 20);
  } catch {
    /*
      Lỗi thì NÓI RA, không im lặng hiện "không có kết quả".

      Hiện danh sách rỗng khi thật ra database không trả lời được là trả lời sai một câu
      hỏi thật: người đọc sẽ tin blog không có bài nào về chủ đề đó và đi mất.
    */
    searchFailed = true;
  }
}

const hasQuery = term.length >= 2;
---

<BaseLayout
  title={term ? `Tìm: ${term}` : 'Tìm kiếm'}
  description="Tìm bài viết theo từ khoá. Tìm được cả khi gõ không dấu — nhập “tieng viet” vẫn ra bài về tiếng Việt, và kết quả luôn là nội dung mới nhất."
  noindex
>
  <div class="wrap-prose py-12">
    <p class="eyebrow">Tra cứu</p>
    <h1 class="display-xl mt-3 text-4xl">Tìm kiếm</h1>
    <p class="mt-4 text-muted">
      Gõ có dấu hay không dấu đều được — <span class="text-fg">tieng viet</span> cũng ra bài về
      tiếng Việt. Kết quả tìm trực tiếp trong nội dung mới nhất, không phải chỉ mục dựng sẵn.
    </p>

    {
      /*
        `<form method="get">` bọc ô nhập, cố ý.

        Không có JS thì Enter vẫn nộp form và trang trả về kết quả — đó là lý do phần tìm
        kiếm chạy phía máy chủ. Bản trước dùng Pagefind nên không có JS là không có gì cả.
      */
    }
    <form method="get" action="/search" role="search" class="relative mt-8">
      <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted">
        <Icon name="search" size={18} />
      </span>
      <label for="search-input" class="sr-only">Từ khoá tìm kiếm</label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        value={term}
        placeholder="Nhập từ khoá, ví dụ: astro, css, seo"
        class="w-full rounded-lg border border-border bg-bg py-3 pr-4 pl-12 text-fg placeholder:text-muted"
      />
      <button type="submit" class="sr-only">Tìm</button>
    </form>

    <p id="search-status" role="status" aria-live="polite" class="mt-4 text-sm text-muted">
      {
        searchFailed
          ? 'Không tìm kiếm được lúc này. Thử lại sau một lát.'
          : hasQuery
            ? results.length === 0
              ? `Không có kết quả cho “${term}”.`
              : `${results.length} kết quả cho “${term}”.`
            : ''
      }
    </p>

    <ul id="search-results" class="mt-2 divide-y divide-border">
      {
        results.map((r) => (
          <li class="py-5">
            <a href={postHref(r.slug)} class="font-bold hover:text-accent">
              {r.title}
            </a>
            <p class="mt-1.5 text-sm text-muted">{r.description}</p>
          </li>
        ))
      }
    </ul>

    <div
      id="search-browse"
      class="mt-10 border-t border-border pt-8"
      hidden={hasQuery && results.length > 0}
    >
      <h2 class="eyebrow">Duyệt theo chủ đề</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          tags.slice(0, 12).map((tag) => (
            <li>
              <TagPill name={tag.name} count={tag.count} />
            </li>
          ))
        }
      </ul>

      <h2 class="eyebrow mt-9">Bài mới nhất</h2>
      <div class="mt-3">
        {baiMoi.map((post, i) => <PostCard post={post} variant="compact" index={i + 1} />)}
      </div>

      <a
        href="/blog"
        class="tap mt-5 inline-block py-1 text-sm text-accent transition-colors hover:text-accent-hover"
      >
        Xem tất cả {posts.length} bài viết →
      </a>
    </div>
  </div>
</BaseLayout>

{
  /*
    Không còn script nạp Pagefind.

    Bản trước phải nạp `/pagefind/pagefind.js` bằng `is:inline` vì thư mục đó chỉ tồn tại
    SAU `astro build`, nên Vite không phân giải được lúc build. Cả cái bẫy đó biến mất khi
    tìm kiếm chuyển sang một endpoint bình thường của site.
  */
}

<script>
  /**
   * Lớp tăng cường: gõ tới đâu thấy tới đó.
   *
   * Trang đã có kết quả trong HTML từ máy chủ, nên đoạn này KHÔNG phải điều kiện để tìm
   * kiếm hoạt động — nó chỉ bỏ bớt một lần tải trang. Tắt JS thì form vẫn nộp và vẫn ra
   * kết quả.
   */
  interface SearchHit {
    href: string;
    title: string;
    description: string;
  }

  const form = document.querySelector<HTMLFormElement>('form[role="search"]');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results');
  const status = document.getElementById('search-status');
  const browse = document.getElementById('search-browse');

  /**
   * Khối duyệt chỉ ẩn khi thật sự CÓ kết quả. Xoá hết chữ, hoặc tìm không ra gì, thì nó
   * hiện lại — nếu không, người vừa xoá từ khoá sẽ nhìn vào một trang trắng.
   */
  function showBrowse(hien: boolean) {
    browse?.toggleAttribute('hidden', !hien);
  }

  /** Gán bằng `textContent`, không phải `innerHTML`. Tiêu đề bài là dữ liệu, không phải mã. */
  function renderResults(items: SearchHit[]) {
    if (!list) return;
    list.replaceChildren(
      ...items.map((r) => {
        const li = document.createElement('li');
        li.className = 'py-5';

        const a = document.createElement('a');
        a.href = r.href;
        a.className = 'font-bold hover:text-accent';
        a.textContent = r.title;

        const p = document.createElement('p');
        p.className = 'mt-1.5 text-sm text-muted';
        p.textContent = r.description;

        li.append(a, p);
        return li;
      }),
    );
  }

  /** Bỏ qua kết quả của một truy vấn đã cũ, khi hai lần fetch về không đúng thứ tự. */
  let latestSeq = 0;

  async function runSearch(q: string) {
    if (!list || !status) return;

    const term = q.trim();

    if (term.length < 2) {
      renderResults([]);
      status.textContent = '';
      showBrowse(true);
      updateUrl('');
      return;
    }

    const seq = ++latestSeq;
    status.textContent = 'Đang tìm…';

    try {
      const res = await fetch(`/search.json?q=${encodeURIComponent(term)}`);
      if (seq !== latestSeq) return;

      if (!res.ok) {
        status.textContent = 'Không tìm kiếm được lúc này. Thử lại sau một lát.';
        return;
      }

      const data = (await res.json()) as { results: SearchHit[] };
      if (seq !== latestSeq) return;

      renderResults(data.results);
      status.textContent =
        data.results.length === 0
          ? `Không có kết quả cho “${term}”.`
          : `${data.results.length} kết quả cho “${term}”.`;
      showBrowse(data.results.length === 0);
      updateUrl(term);
    } catch {
      if (seq === latestSeq) {
        status.textContent = 'Không tìm kiếm được lúc này. Thử lại sau một lát.';
      }
    }
  }

  /**
   * Cập nhật URL bằng `replaceState`, không phải `pushState`.
   *
   * Gõ 12 chữ thì `pushState` nhét 12 mục vào lịch sử, và người đọc phải bấm Back 12 lần
   * mới ra khỏi trang tìm kiếm. Nhưng URL vẫn phải đổi: nhờ vậy link kết quả chia sẻ được
   * và tải lại trang không mất truy vấn.
   */
  function updateUrl(q: string) {
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    window.history.replaceState(null, '', url);
  }

  // Chờ 250ms sau lần gõ cuối — mỗi lần gõ giờ là một truy vấn database, không phải một
  // lần tra chỉ mục trong bộ nhớ như bản Pagefind.
  let timer: number | undefined;
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => void runSearch(input.value), 250);
  });

  // Có JS thì Enter không cần tải lại trang nữa.
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.clearTimeout(timer);
    if (input) void runSearch(input.value);
  });

  input?.focus();
</script>
