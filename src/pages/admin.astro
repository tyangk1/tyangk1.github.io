---
import { ENV } from '~/env';
import { GIOI_HAN } from '../../scripts/lib/kiem-bai.mjs';

/**
 * Trang quản trị chạy TRÊN SITE — dùng để sửa bài từ điện thoại hoặc máy khác.
 *
 * KHÁC GÌ `pnpm admin`
 *
 *   `pnpm admin` (cục bộ)  — có xem trước sống và nút Đồng bộ. Là chỗ viết bài dài.
 *   `/admin`     (trang này) — sửa nhanh ở bất cứ đâu. Không xem trước được vì
 *                              trình duyệt không chạy được `pnpm sync`; thay vào đó
 *                              workflow "Tự động publish" chạy mỗi 20 phút và đưa
 *                              thay đổi lên site.
 *
 * BẢO MẬT
 *
 * Trang này là HTML công khai — ai cũng mở được. Điều đó KHÔNG sao, vì mọi thứ
 * quan trọng nằm ở tầng database:
 *
 *   - Phải đăng nhập bằng Supabase Auth mới có token.
 *   - Có token cũng chưa đủ: RLS chỉ cho ghi nếu `auth.uid()` có tên trong bảng
 *     `admins`. `authenticated` trong Supabase nghĩa là bất kỳ ai đăng ký được,
 *     nên riêng việc đăng nhập không cấp quyền gì.
 *   - Đã kiểm bằng một tài khoản thật không có trong `admins`: ghi mới trả 403,
 *     sửa và xoá trả 204 nhưng 0 dòng thay đổi, đã xác minh trong database.
 *
 * Khoá dùng ở đây là khoá CÔNG KHAI, đúng thứ đã có trong mọi trang khác của site.
 * Không có bí mật nào trong bundle.
 */
const bat = Boolean(ENV.publicSupabaseUrl && ENV.publicSupabaseAnonKey);
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Quản trị nội dung</title>
    <style is:inline>
      :root {
        --bg: #0d1117;
        --panel: #161b22;
        --vien: #30363d;
        --chu: #e6edf3;
        --mo: #8b949e;
        --xanh: #58a6ff;
        --luc: #3fb950;
        --do: #f85149;
        --vang: #d29922;
        --tim: #a371f7;
        --cam: #ffa657;
        --mono: ui-monospace, 'Cascadia Code', Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        font:
          15px/1.5 ui-sans-serif,
          system-ui,
          sans-serif;
        background: var(--bg);
        color: var(--chu);
      }

      /* --- Đăng nhập --- */
      .vao {
        max-width: 380px;
        margin: 14vh auto;
        padding: 0 18px;
      }
      .vao h1 {
        font-size: 20px;
        margin: 0 0 6px;
      }
      .vao p {
        color: var(--mo);
        font-size: 13px;
        margin: 0 0 20px;
      }

      /* --- Khung chính --- */
      .khung {
        display: grid;
        grid-template-columns: 260px 1fr;
        height: 100dvh;
        overflow: hidden;
      }
      aside {
        border-right: 1px solid var(--vien);
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      .ds {
        overflow-y: auto;
        flex: 1;
      }
      .muc {
        padding: 10px 12px;
        border-bottom: 1px solid var(--vien);
        cursor: pointer;
        display: grid;
        gap: 3px;
      }
      .muc[aria-current='true'] {
        background: var(--panel);
        box-shadow: inset 3px 0 0 var(--xanh);
      }
      .muc b {
        font-size: 13px;
        font-weight: 600;
      }
      .muc small {
        color: var(--mo);
        font-size: 11px;
        display: flex;
        gap: 6px;
      }
      .the {
        font-size: 10px;
        padding: 1px 5px;
        border-radius: 999px;
        border: 1px solid currentColor;
      }
      .nhap {
        color: var(--vang);
      }
      .dang {
        color: var(--luc);
      }
      /* Đặt lịch: xong rồi, đang chờ tới ngày. Xanh chứ không vàng — vàng là
         "còn việc phải làm", còn bài này thì không cần làm gì nữa. */
      .dat_lich {
        color: var(--xanh);
      }

      /* Lời nhắc bên phải nhãn "Ngày đăng". Bỏ in nghiêng: đây là câu thông báo
         trạng thái, không phải chữ được nhấn mạnh. */
      #hen {
        font-style: normal;
        text-align: right;
      }

      main {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
      }
      .thanh,
      .dau {
        padding: 9px 13px;
        display: flex;
        gap: 7px;
        align-items: center;
        border-bottom: 1px solid var(--vien);
        flex-wrap: wrap;
        flex: none;
      }
      .cot {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 14px 16px 60px;
        min-width: 0;
      }

      label {
        display: block;
        margin-bottom: 11px;
      }
      .nhan {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        color: var(--mo);
        margin-bottom: 4px;
      }
      input,
      textarea {
        width: 100%;
        background: var(--bg);
        color: var(--chu);
        border: 1px solid var(--vien);
        border-radius: 6px;
        padding: 9px 10px;
        font: inherit;
      }
      input[type='checkbox'] {
        width: auto;
      }
      input:focus,
      textarea:focus {
        outline: 2px solid var(--xanh);
        outline-offset: -1px;
      }
      button {
        background: var(--panel);
        color: var(--chu);
        border: 1px solid var(--vien);
        border-radius: 6px;
        padding: 9px 13px;
        font: inherit;
        cursor: pointer;
        min-height: 38px;
      }
      button.chinh {
        background: #1f6feb;
        border-color: #1f6feb;
        font-weight: 600;
      }
      button.nguyhiem:hover {
        border-color: var(--do);
        color: var(--do);
      }
      button:disabled {
        opacity: 0.5;
      }
      .hang {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px;
      }
      fieldset {
        border: 1px solid var(--vien);
        border-radius: 6px;
        padding: 12px;
        margin: 0 0 12px;
      }
      legend {
        font-size: 12px;
        color: var(--mo);
        padding: 0 6px;
      }
      .cb {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }
      .cb label {
        display: flex;
        gap: 7px;
        align-items: center;
        margin: 0;
        font-size: 14px;
      }
      .dem.ok {
        color: var(--luc);
      }
      .dem.sai {
        color: var(--do);
      }
      #tt {
        margin-left: auto;
        font-size: 12px;
        color: var(--mo);
      }
      #tt.ok {
        color: var(--luc);
      }
      #tt.sai {
        color: var(--do);
      }
      #loi:not(:empty) {
        border: 1px solid var(--do);
        background: #f8514915;
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 12px;
      }
      #loi ul {
        margin: 0;
        padding-left: 18px;
      }
      .ghi {
        color: var(--mo);
        font-size: 11px;
        margin-top: 3px;
      }

      /* Ô soạn phủ lớp tô màu — cùng kỹ thuật và cùng module với `pnpm admin`.
         Xem `scripts/lib/to-mau-mdx.mjs`. */
      .khung-soan {
        position: relative;
        border: 1px solid var(--vien);
        border-radius: 6px;
        overflow: hidden;
      }
      .khung-soan:focus-within {
        outline: 2px solid var(--xanh);
        outline-offset: -1px;
      }
      #hl,
      #content {
        margin: 0;
        padding: 10px 12px;
        font: 13px/1.7 var(--mono);
        white-space: pre-wrap;
        word-break: break-word;
        border: 0;
        tab-size: 2;
      }
      #hl {
        position: absolute;
        inset: 0;
        overflow: auto;
        pointer-events: none;
      }
      #content {
        position: relative;
        display: block;
        height: 55vh;
        min-height: 280px;
        background: transparent;
        color: transparent;
        caret-color: var(--chu);
        border-radius: 0;
        resize: vertical;
      }
      .t-heading {
        color: var(--xanh);
        font-weight: 700;
      }
      .t-tag {
        color: var(--tim);
      }
      .t-code {
        color: var(--cam);
      }
      .t-fence {
        color: var(--mo);
      }
      .t-manh {
        font-weight: 700;
      }
      .t-nghieng {
        font-style: italic;
      }
      .t-link {
        color: var(--luc);
      }
      .t-trich {
        color: var(--mo);
        font-style: italic;
      }
      .t-ds {
        color: var(--vang);
      }
      .congcu {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-bottom: 6px;
      }
      .congcu button {
        padding: 6px 9px;
        font-size: 12px;
        min-height: 34px;
      }
      .keo {
        border: 1px dashed var(--vien);
        border-radius: 6px;
        padding: 10px;
        text-align: center;
        color: var(--mo);
        font-size: 12px;
        margin-top: 10px;
      }
      #nut-ds {
        display: none;
      }

      @media (max-width: 900px) {
        .khung {
          grid-template-columns: 1fr;
          grid-template-rows: auto 1fr;
        }
        aside {
          border-right: 0;
          border-bottom: 1px solid var(--vien);
          max-height: 42vh;
        }
        #nut-ds {
          display: inline-block;
        }
        .hang {
          grid-template-columns: 1fr;
        }
        #content {
          height: 48vh;
        }
      }
    </style>
  </head>

  <body>
    {
      !bat ? (
        <div class="vao">
          <h1>Chưa cấu hình</h1>
          <p>
            Trang quản trị cần <code>PUBLIC_SUPABASE_URL</code> và
            <code>PUBLIC_SUPABASE_ANON_KEY</code> lúc build. Đặt chúng thành GitHub Actions
            variables rồi deploy lại.
          </p>
        </div>
      ) : (
        <>
          <div class="vao" id="man-vao">
            <h1>Quản trị nội dung</h1>
            <p>
              Đăng nhập được không có nghĩa là ghi được: quyền ghi do bảng <code>admins</code> trong
              database quyết định.
            </p>
            <form id="form-vao">
              <label>
                <span class="nhan">
                  <span>Email</span>
                </span>
                <input type="email" id="email" autocomplete="username" required />
              </label>
              <label>
                <span class="nhan">
                  <span>Mật khẩu</span>
                </span>
                <input type="password" id="matkhau" autocomplete="current-password" required />
              </label>
              <button class="chinh" type="submit" style="width:100%">
                Đăng nhập
              </button>
              <p id="loi-vao" style="color:var(--do);margin-top:12px" />
            </form>
          </div>

          <div class="khung" id="man-chinh" hidden>
            <aside>
              <div class="dau">
                <button class="chinh" id="nut-moi">
                  + Bài mới
                </button>
                <button id="nut-ra">Đăng xuất</button>
              </div>
              <div class="ds" id="ds" />
            </aside>

            <main>
              <div class="thanh">
                <button id="nut-ds" aria-pressed="false">
                  ☰
                </button>
                <button class="chinh" id="nut-luu">
                  Lưu
                </button>
                <button id="nut-anh">Ảnh…</button>
                <button class="nguyhiem" id="nut-xoa">
                  Xoá
                </button>
                <span id="tt" />
              </div>

              <div class="cot">
                <div id="loi" />

                <fieldset>
                  <legend>Bắt buộc</legend>
                  <label>
                    <span class="nhan">
                      <span>Tiêu đề</span>
                      <span class="dem" id="dem-title" />
                    </span>
                    <input type="text" id="title" />
                  </label>
                  <label>
                    <span class="nhan">
                      <span>Slug — không đổi sau khi đã đăng</span>
                      <span class="dem" id="dem-slug" />
                    </span>
                    <input type="text" id="slug" />
                    <span class="ghi" id="ghi-slug" />
                  </label>
                  <label>
                    <span class="nhan">
                      <span>Mô tả (meta description)</span>
                      <span class="dem" id="dem-description" />
                    </span>
                    <textarea id="description" rows="3" />
                  </label>
                  <div class="hang">
                    <label>
                      <span class="nhan">
                        <span>Tag, cách nhau bằng phẩy</span>
                        <span class="dem" id="dem-tags" />
                      </span>
                      <input type="text" id="tags" />
                    </label>
                    <label>
                      <span class="nhan">
                        <span>Ngày đăng</span>
                        <em id="hen" />
                      </span>
                      <input type="date" id="published_at" />
                    </label>
                  </div>
                </fieldset>

                <fieldset>
                  <legend>Tuỳ chọn</legend>
                  <label>
                    <span class="nhan">
                      <span>Điểm chính — mỗi dòng một ý</span>
                      <span class="dem" id="dem-takeaways" />
                    </span>
                    <textarea id="takeaways" rows="4" />
                  </label>
                  <div class="hang">
                    <label>
                      <span class="nhan">
                        <span>Ảnh bìa (URL)</span>
                      </span>
                      <input type="text" id="cover_image" />
                    </label>
                    <label>
                      <span class="nhan">
                        <span>Mô tả ảnh bìa (alt)</span>
                      </span>
                      <input type="text" id="cover_alt" />
                    </label>
                  </div>
                  <div class="hang">
                    <label>
                      <span class="nhan">
                        <span>Tên series</span>
                      </span>
                      <input type="text" id="series_name" />
                    </label>
                    <label>
                      <span class="nhan">
                        <span>Phần thứ</span>
                      </span>
                      <input type="number" id="series_part" min="1" />
                    </label>
                  </div>
                  <label>
                    <span class="nhan">
                      <span>Ngày cập nhật nội dung</span>
                    </span>
                    <input type="date" id="content_updated_at" />
                  </label>
                  <div class="cb">
                    <label>
                      <input type="checkbox" id="draft" /> Bài nháp
                    </label>
                    <label>
                      <input type="checkbox" id="featured" /> Nổi bật
                    </label>
                  </div>
                </fieldset>

                <div class="nhan">
                  <span>Thân bài (MDX)</span>
                  <span class="dem" id="dem-content" />
                </div>

                <div class="congcu" id="congcu">
                  <button data-tt="## ">H2</button>
                  <button data-tt="### ">H3</button>
                  <button data-bao="**">
                    <b>B</b>
                  </button>
                  <button data-bao="_">
                    <i>I</i>
                  </button>
                  <button data-bao="`">code</button>
                  <button data-lam="link">link</button>
                  <button data-tt="- ">• ds</button>
                  <button data-lam="fence">```</button>
                  <button data-lam="callout">Callout</button>
                  <button data-lam="steps">Steps</button>
                  <button data-lam="figure">Figure</button>
                  <button data-lam="pullquote">PullQuote</button>
                </div>

                <div class="khung-soan">
                  <pre id="hl" aria-hidden="true">
                    <code />
                  </pre>
                  <textarea id="content" spellcheck="false" />
                </div>

                <div class="keo" id="keo">
                  Kéo ảnh vào đây, hoặc bấm “Ảnh…”
                </div>
                <p class="ghi" style="margin-top:14px">
                  Lưu là xong — nội dung vào database ngay. Site tĩnh nên bài lên trong vòng 20
                  phút, do workflow “Tự động publish” chạy. Cần ngay thì bấm Run workflow ở tab
                  Actions.
                </p>
              </div>
            </main>
          </div>

          <input type="file" id="chon-file" accept="image/*" multiple hidden />
        </>
      )
    }

    <script
      define:vars={{
        URL_SB: ENV.publicSupabaseUrl,
        KHOA: ENV.publicSupabaseAnonKey,
        GIOI_HAN,
      }}
      is:inline
    >
      window.__ADMIN = { URL_SB, KHOA, GIOI_HAN };
    </script>

    <script>
      import { toMauMdx, MAU_MDX } from '../../scripts/lib/to-mau-mdx.mjs';
      import {
        kiemBai,
        chuanHoaBai,
        trangThaiBai,
        NHAN_TRANG_THAI,
        ngayHomNay,
      } from '../../scripts/lib/kiem-bai.mjs';

      const cfg = (window as unknown as { __ADMIN?: Record<string, unknown> }).__ADMIN;
      const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
      const val = (id: string) => ($(id) as HTMLInputElement | null)?.value ?? '';

      if (cfg) {
        const URL_SB = cfg['URL_SB'] as string;
        const KHOA = cfg['KHOA'] as string;
        const G = cfg['GIOI_HAN'] as Record<string, number>;
        const KHOA_PHIEN = 'admin-phien';

        let phien: { access_token: string; refresh_token: string } | null = null;
        let danhSach: Record<string, unknown>[] = [];
        let slugDangSua: string | null = null;

        // --- Gọi Supabase ---------------------------------------------------
        const dau = () => ({
          apikey: KHOA,
          Authorization: `Bearer ${phien?.access_token ?? KHOA}`,
          'Content-Type': 'application/json',
        });

        function tt(chu: string, loai = '') {
          const el = $('tt');
          if (el) {
            el.textContent = chu;
            el.className = loai;
          }
        }

        /**
         * Access token của Supabase sống 1 giờ. Viết một bài dài là chắc chắn hết
         * hạn giữa lúc viết, và lúc đó mọi lần lưu sẽ trả 401 — mất bài. Nên làm
         * mới bằng refresh token trước khi gọi, khi gặp 401.
         */
        async function goi(
          duong: string,
          tuyChon: RequestInit = {},
          thuLai = true,
        ): Promise<Response> {
          const res = await fetch(`${URL_SB}${duong}`, { ...tuyChon, headers: dau() });
          if (res.status !== 401 || !thuLai || !phien) return res;

          const r = await fetch(`${URL_SB}/auth/v1/token?grant_type=refresh_token`, {
            method: 'POST',
            headers: { apikey: KHOA, 'Content-Type': 'application/json' },
            body: JSON.stringify({ refresh_token: phien.refresh_token }),
          });
          if (!r.ok) {
            dangXuat();
            return res;
          }
          const moi = await r.json();
          phien = { access_token: moi.access_token, refresh_token: moi.refresh_token };
          localStorage.setItem(KHOA_PHIEN, JSON.stringify(phien));
          return goi(duong, tuyChon, false);
        }

        function dangXuat() {
          phien = null;
          localStorage.removeItem(KHOA_PHIEN);
          $('man-chinh')!.hidden = true;
          $('man-vao')!.hidden = false;
        }

        // --- Tô màu ---------------------------------------------------------
        const hlCode = $('hl')!.firstElementChild!;
        const ta = () => $('content') as HTMLTextAreaElement;

        function veLaiHl() {
          hlCode.innerHTML = toMauMdx(ta().value);
          $('hl')!.scrollTop = ta().scrollTop;
        }

        function thayDoan(a: number, b: number, chuoi: string) {
          const t = ta();
          t.setRangeText(chuoi, a, b, 'end');
          t.focus();
          t.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function bao(dau2: string) {
          const t = ta();
          const { selectionStart: a, selectionEnd: b, value: v } = t;
          thayDoan(a, b, `${dau2}${v.slice(a, b)}${dau2}`);
          if (a === b) t.selectionStart = t.selectionEnd = a + dau2.length;
        }

        function themTienTo(tt2: string) {
          const t = ta();
          const v = t.value;
          const d = v.lastIndexOf('\n', t.selectionStart - 1) + 1;
          const c =
            v.indexOf('\n', t.selectionEnd) === -1 ? v.length : v.indexOf('\n', t.selectionEnd);
          const khoi = v
            .slice(d, c)
            .split('\n')
            .map((x) => (x.startsWith(tt2) ? x.slice(tt2.length) : tt2 + x))
            .join('\n');
          thayDoan(d, c, khoi);
        }

        // --- Đếm ------------------------------------------------------------
        function dem(id: string, n: number, min: number, max: number) {
          const el = $(`dem-${id}`);
          if (!el) return;
          el.textContent = `${n} / ${min}–${max}`;
          el.className = `dem ${n >= min && n <= max ? 'ok' : 'sai'}`;
        }

        /**
         * Viết lời nhắc vào `#hen`, ngay bên phải nhãn "Ngày đăng".
         *
         * Ô ngày đăng là một cái HẸN, không phải chữ để hiển thị: để ngày mai thì bài
         * nằm im tới đúng ngày đó rồi tự lên. Không nói ra thì không ai đoán được —
         * tính năng không ai biết là tính năng không tồn tại.
         *
         * Ba câu, khớp với ba trạng thái trong `trangThaiBai`:
         *   nháp            — ngày chưa có tác dụng, bài không lên dù để ngày nào.
         *   tương lai       — đang hẹn; nói rõ còn mấy ngày và rằng KHÔNG cần làm gì.
         *   hôm nay/quá khứ — sẽ lên ở lần đồng bộ kế tiếp.
         *
         * Lưu ý cho người sửa sau: markup của trang này nằm trong một biểu thức
         * ternary `{!bat ? (...) : (...)}`, tức là JSX. Đừng đặt `<!-- -->` vào đó —
         * prettier sẽ ném SyntaxError và CI đỏ. Chú thích về markup viết ở đây.
         */
        function capNhatHen() {
          const el = $('hen');
          if (!el) return;

          const ngay = val('published_at');
          const nhap = ($('draft') as HTMLInputElement | null)?.checked;

          if (nhap) {
            el.textContent = 'đang là nháp — ngày chưa có tác dụng';
            el.className = 'nhap';
            return;
          }
          if (!ngay) {
            el.textContent = '';
            return;
          }

          const homNay = ngayHomNay();
          if (ngay > homNay) {
            const soNgay = Math.round(
              (Date.parse(`${ngay}T00:00:00Z`) - Date.parse(`${homNay}T00:00:00Z`)) / 86400000,
            );
            el.textContent = `đặt lịch — tự lên sau ${soNgay} ngày, không cần làm gì`;
            el.className = 'dat_lich';
          } else {
            el.textContent = 'sẽ lên site ở lần đồng bộ kế tiếp (~20 phút)';
            el.className = 'dang';
          }
        }

        function capNhatDem() {
          dem('title', val('title').trim().length, 1, G['titleToiDa']!);
          dem(
            'description',
            val('description').trim().length,
            G['descriptionMin']!,
            G['descriptionMax']!,
          );
          dem(
            'tags',
            val('tags')
              .split(',')
              .filter((t) => t.trim()).length,
            G['tagsMin']!,
            G['tagsMax']!,
          );

          const tk = val('takeaways')
            .split('\n')
            .filter((t) => t.trim());
          const okTk =
            tk.length === 0 || (tk.length >= G['takeawaysMin']! && tk.length <= G['takeawaysMax']!);
          const elTk = $('dem-takeaways')!;
          elTk.textContent = `${tk.length} dòng`;
          elTk.className = `dem ${okTk ? 'ok' : 'sai'}`;

          const chu = ta().value.trim().split(/\s+/).filter(Boolean).length;
          $('dem-content')!.textContent =
            `${chu.toLocaleString('vi-VN')} từ · ~${Math.max(1, Math.round(chu / 200))} phút`;

          capNhatHen();

          const slug = val('slug').trim();
          const hopLe = /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug);
          $('dem-slug')!.textContent = slug ? (hopLe ? 'hợp lệ' : 'sai định dạng') : '';
          $('dem-slug')!.className = `dem ${slug && hopLe ? 'ok' : slug ? 'sai' : ''}`;
          $('ghi-slug')!.textContent = slug ? `URL: /blog/${slug}` : '';
        }

        function slugHoa(s: string) {
          return s
            .normalize('NFD')
            .replace(/\p{M}/gu, '')
            .replace(/[đĐ]/g, (c) => (c === 'đ' ? 'd' : 'D'))
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        // --- Form -----------------------------------------------------------
        function docForm() {
          return {
            slug: val('slug'),
            title: val('title'),
            description: val('description'),
            content: ta().value,
            published_at: val('published_at') || null,
            content_updated_at: val('content_updated_at') || null,
            tags: val('tags')
              .split(',')
              .map((t) => t.trim())
              .filter(Boolean),
            takeaways: val('takeaways')
              .split('\n')
              .map((t) => t.trim())
              .filter(Boolean),
            series_name: val('series_name'),
            series_part: val('series_part'),
            cover_image: val('cover_image'),
            cover_alt: val('cover_alt'),
            draft: ($('draft') as HTMLInputElement).checked,
            featured: ($('featured') as HTMLInputElement).checked,
          };
        }

        function dienForm(b: Record<string, any> | null) {
          const dat = (id: string, v: unknown) => {
            ($(id) as HTMLInputElement).value = v == null ? '' : String(v);
          };
          dat('title', b?.title);
          dat('slug', b?.slug);
          dat('description', b?.description);
          dat('content', b?.content);
          // `ngayHomNay()` chứ không phải `toISOString()`: cái sau cho ra ngày UTC,
          // nên mở form lúc 6 giờ sáng ở Việt Nam sẽ điền lùi mất một ngày.
          dat('published_at', b?.published_at ?? ngayHomNay());
          dat('content_updated_at', b?.content_updated_at);
          dat('tags', (b?.tags ?? []).join(', '));
          dat('takeaways', (b?.takeaways ?? []).join('\n'));
          dat('series_name', b?.series_name);
          dat('series_part', b?.series_part);
          dat('cover_image', b?.cover_image);
          dat('cover_alt', b?.cover_alt);
          ($('draft') as HTMLInputElement).checked = b ? Boolean(b.draft) : true;
          ($('featured') as HTMLInputElement).checked = Boolean(b?.featured);

          slugDangSua = (b?.slug as string) ?? null;
          ($('nut-xoa') as HTMLButtonElement).disabled = !b;
          $('loi')!.innerHTML = '';
          capNhatDem();
          veLaiHl();
          veDanhSach();
        }

        function veDanhSach() {
          $('ds')!.innerHTML = danhSach
            .map((b: any) => {
              const t = String(b.title).replace(/</g, '&lt;');
              return `<div class="muc" data-slug="${b.slug}" ${b.slug === slugDangSua ? 'aria-current="true"' : ''}>
                <b>${t}</b>
                <small><span class="the ${trangThaiBai(b)}">${NHAN_TRANG_THAI[trangThaiBai(b)]}</span>${b.published_at ?? ''}</small>
              </div>`;
            })
            .join('');
          for (const el of $('ds')!.querySelectorAll<HTMLElement>('.muc')) {
            el.onclick = () => {
              const b = danhSach.find((x: any) => x.slug === el.dataset['slug']);
              if (b) dienForm(b as any);
              document.querySelector('.cot')?.scrollTo(0, 0);
            };
          }
        }

        async function taiDanhSach() {
          const r = await goi('/rest/v1/posts?select=*&order=published_at.desc');
          if (!r.ok) {
            tt('Không tải được danh sách', 'sai');
            return;
          }
          danhSach = await r.json();
          veDanhSach();
        }

        async function luu() {
          const bai = chuanHoaBai(docForm());
          const loi = kiemBai(bai);
          if (loi.length > 0) {
            $('loi')!.innerHTML =
              `<b>Chưa lưu được:</b><ul>${loi.map((l: any) => `<li>${l.thongDiep}</li>`).join('')}</ul>`;
            tt('Có lỗi cần sửa', 'sai');
            return;
          }

          tt('Đang lưu…');
          const r = await goi('/rest/v1/posts?on_conflict=slug', {
            method: 'POST',
            body: JSON.stringify(bai),
          });

          if (!r.ok) {
            const chiTiet = await r.text();
            $('loi')!.innerHTML =
              `<b>Database từ chối (HTTP ${r.status}):</b><ul><li>${chiTiet.slice(0, 300)}</li></ul>`;
            tt(r.status === 403 ? 'Tài khoản này không có quyền ghi' : 'Lưu thất bại', 'sai');
            return;
          }

          $('loi')!.innerHTML = '';
          slugDangSua = bai.slug;
          await taiDanhSach();
          tt('Đã lưu — site cập nhật trong 20 phút', 'ok');
        }

        // --- Ảnh ------------------------------------------------------------
        async function taiAnh(files: File[]) {
          for (const f of files) {
            const duoi = (f.name.match(/\.[a-z0-9]+$/i)?.[0] ?? '').toLowerCase();
            const ten = slugHoa(f.name.slice(0, f.name.length - duoi.length)) || 'anh';
            const key = `${new Date().getFullYear()}/${ten}${duoi}`;

            tt(`Đang tải ${f.name}…`);

            // KHÔNG gửi `x-upsert`: endpoint POST của Storage từ chối header đó
            // bằng HTTP 400 với body rỗng — đã đo từng header để tìm ra. `x-upsert`
            // chỉ dùng cho luồng PUT của SDK.
            //
            // `max-age=31536000` để ảnh được cache một năm. Supabase mặc định trả
            // `no-cache`, tức mỗi người đọc tải lại ảnh từ đầu.
            const r = await fetch(`${URL_SB}/storage/v1/object/anh-blog/${key}`, {
              method: 'POST',
              headers: {
                apikey: KHOA,
                Authorization: `Bearer ${phien?.access_token}`,
                'Content-Type': f.type,
                'Cache-Control': 'max-age=31536000',
              },
              body: f,
            });

            if (!r.ok) {
              // Trùng tên thì nói rõ, đừng để người dùng đoán. Cố tình KHÔNG tự ghi
              // đè: một bài khác có thể đang dùng đúng ảnh đó.
              tt(
                r.status === 409
                  ? `Đã có ảnh tên "${ten}${duoi}" — đổi tên file rồi thử lại.`
                  : r.status === 403
                    ? 'Tài khoản này không có quyền tải ảnh lên.'
                    : `Không tải được ảnh (HTTP ${r.status})`,
                'sai',
              );
              continue;
            }

            const url = `${URL_SB}/storage/v1/object/public/anh-blog/${key}`;
            if (!val('cover_image')) {
              ($('cover_image') as HTMLInputElement).value = url;
              tt('Đặt làm ảnh bìa — nhớ điền alt', 'ok');
              $('cover_alt')!.focus();
            } else {
              const t = ta();
              thayDoan(
                t.selectionStart,
                t.selectionEnd,
                `\n<Figure\n  src="${url}"\n  alt=""\n  caption=""\n/>\n`,
              );
              tt('Đã chèn <Figure> — nhớ điền alt', 'ok');
            }
          }
        }

        // --- Đăng nhập ------------------------------------------------------
        async function vaoVoiPhien() {
          $('man-vao')!.hidden = true;
          $('man-chinh')!.hidden = false;
          await taiDanhSach();
          dienForm(null);
        }

        $('form-vao')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          const oLoi = $('loi-vao')!;
          oLoi.textContent = 'Đang đăng nhập…';

          const r = await fetch(`${URL_SB}/auth/v1/token?grant_type=password`, {
            method: 'POST',
            headers: { apikey: KHOA, 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: val('email'), password: val('matkhau') }),
          });

          if (!r.ok) {
            oLoi.textContent = 'Email hoặc mật khẩu không đúng.';
            return;
          }

          const d = await r.json();
          phien = { access_token: d.access_token, refresh_token: d.refresh_token };
          localStorage.setItem(KHOA_PHIEN, JSON.stringify(phien));
          oLoi.textContent = '';
          await vaoVoiPhien();
        });

        $('nut-ra')!.onclick = dangXuat;
        $('nut-luu')!.onclick = luu;
        $('nut-moi')!.onclick = () => {
          dienForm(null);
          $('title')!.focus();
        };
        $('nut-xoa')!.onclick = async () => {
          if (!slugDangSua) return;
          if (!confirm(`Xoá hẳn bài "${slugDangSua}"?\n\nKhông hoàn lại được.`)) return;
          const r = await goi(`/rest/v1/posts?slug=eq.${encodeURIComponent(slugDangSua)}`, {
            method: 'DELETE',
          });
          if (!r.ok) {
            tt('Không xoá được', 'sai');
            return;
          }
          await taiDanhSach();
          dienForm(null);
          tt('Đã xoá', 'ok');
        };
        $('nut-ds')!.onclick = () => {
          const a = document.querySelector('aside')!;
          a.hidden = !a.hidden;
        };
        $('nut-anh')!.onclick = () => ($('chon-file') as HTMLInputElement).click();
        ($('chon-file') as HTMLInputElement).onchange = (e) =>
          taiAnh([...((e.target as HTMLInputElement).files ?? [])]);

        const keo = $('keo')!;
        for (const su of ['dragenter', 'dragover'])
          keo.addEventListener(su, (e) => e.preventDefault());
        keo.addEventListener('drop', (e) => {
          e.preventDefault();
          const dt = (e as DragEvent).dataTransfer;
          taiAnh([...(dt?.files ?? [])].filter((f) => f.type.startsWith('image/')));
        });

        $('congcu')!.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('button');
          if (!b) return;
          e.preventDefault();
          if (b.dataset['tt']) return themTienTo(b.dataset['tt']);
          if (b.dataset['bao']) return bao(b.dataset['bao']);
          const lam = b.dataset['lam'];
          if (lam === 'link') {
            const t = ta();
            const chon = t.value.slice(t.selectionStart, t.selectionEnd) || 'chữ hiện ra';
            return thayDoan(t.selectionStart, t.selectionEnd, `[${chon}](https://)`);
          }
          const mau = (MAU_MDX as Record<string, string>)[lam ?? ''];
          if (mau) {
            const t = ta();
            thayDoan(t.selectionStart, t.selectionEnd, mau);
          }
        });

        for (const id of ['title', 'slug', 'description', 'tags', 'takeaways', 'content'])
          $(id)!.addEventListener('input', capNhatDem);

        // Ngày đăng và ô nháp cũng phải gọi lại — cả hai đổi câu ở `#hen`. Thiếu
        // hai dòng này thì lời nhắc "đặt lịch" chỉ đúng lúc mới mở form rồi đứng im.
        $('published_at')!.addEventListener('input', capNhatDem);
        $('draft')!.addEventListener('change', capNhatDem);
        $('content')!.addEventListener('input', veLaiHl);
        $('content')!.addEventListener('scroll', () => {
          $('hl')!.scrollTop = ta().scrollTop;
        });
        $('title')!.addEventListener('input', () => {
          if (!slugDangSua) ($('slug') as HTMLInputElement).value = slugHoa(val('title'));
          capNhatDem();
        });

        document.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            if (!$('man-chinh')!.hidden) luu();
          }
        });

        // Có phiên cũ trong localStorage thì vào luôn, không phải đăng nhập lại.
        const luuTru = localStorage.getItem(KHOA_PHIEN);
        if (luuTru) {
          try {
            phien = JSON.parse(luuTru);
            void vaoVoiPhien();
          } catch {
            localStorage.removeItem(KHOA_PHIEN);
          }
        }
      }
    </script>
  </body>
</html>
