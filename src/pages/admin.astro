---
import { ENV } from '~/env';
import { LIMITS } from '../../scripts/lib/post.mjs';

/**
 * Trang quản trị chạy TRÊN SITE — dùng để sửa bài từ điện thoại hoặc máy khác.
 *
 * KHÁC GÌ `pnpm admin`
 *
 *   `pnpm admin` (cục bộ)  — có xem trước sống và nút Đồng bộ. Là chỗ viết bài dài.
 *   `/admin`     (trang này) — sửa nhanh ở bất cứ đâu. Không xem trước được vì
 *                              trình duyệt không chạy được `pnpm sync`; thay vào đó
 *                              workflow "Tự động publish" chạy mỗi 20 phút và đưa
 *                              thay đổi lên site.
 *
 * BẢO MẬT
 *
 * Trang này là HTML công khai — ai cũng mở được. Điều đó KHÔNG sao, vì mọi thứ
 * quan trọng nằm ở tầng database:
 *
 *   - Phải đăng nhập bằng Supabase Auth mới có token.
 *   - Có token cũng chưa đủ: RLS chỉ cho ghi nếu `auth.uid()` có tên trong bảng
 *     `admins`. `authenticated` trong Supabase nghĩa là bất kỳ ai đăng ký được,
 *     nên riêng việc đăng nhập không cấp quyền gì.
 *   - Đã kiểm bằng một tài khoản thật không có trong `admins`: ghi mới trả 403,
 *     sửa và xoá trả 204 nhưng 0 dòng thay đổi, đã xác minh trong database.
 *
 * Khoá dùng ở đây là khoá CÔNG KHAI, đúng thứ đã có trong mọi trang khác của site.
 * Không có bí mật nào trong bundle.
 */
const enabled = Boolean(ENV.publicSupabaseUrl && ENV.publicSupabaseAnonKey);
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Quản trị nội dung</title>
    <style is:inline>
      :root {
        --bg: #0d1117;
        --panel: #161b22;
        --border: #30363d;
        --text: #e6edf3;
        --muted: #8b949e;
        --blue: #58a6ff;
        --green: #3fb950;
        --red: #f85149;
        --yellow: #d29922;
        --purple: #a371f7;
        --orange: #ffa657;
        --mono: ui-monospace, 'Cascadia Code', Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        font:
          15px/1.5 ui-sans-serif,
          system-ui,
          sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      /* --- Đăng nhập --- */
      .login {
        max-width: 380px;
        margin: 14vh auto;
        padding: 0 18px;
      }
      .login h1 {
        font-size: 20px;
        margin: 0 0 6px;
      }
      .login p {
        color: var(--muted);
        font-size: 13px;
        margin: 0 0 20px;
      }

      /* --- Khung chính --- */
      .shell {
        display: grid;
        grid-template-columns: 260px 1fr;
        height: 100dvh;
        overflow: hidden;
      }
      aside {
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      .list {
        overflow-y: auto;
        flex: 1;
      }
      .item {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        display: grid;
        gap: 3px;
      }
      .item[aria-current='true'] {
        background: var(--panel);
        box-shadow: inset 3px 0 0 var(--blue);
      }
      .item b {
        font-size: 13px;
        font-weight: 600;
      }
      .item small {
        color: var(--muted);
        font-size: 11px;
        display: flex;
        gap: 6px;
      }
      .badge {
        font-size: 10px;
        padding: 1px 5px;
        border-radius: 999px;
        border: 1px solid currentColor;
      }
      .draft {
        color: var(--yellow);
      }
      .published {
        color: var(--green);
      }
      /* Đặt lịch: xong rồi, đang chờ tới ngày. Xanh chứ không vàng — vàng là
         "còn việc phải làm", còn bài này thì không cần làm gì nữa. */
      .scheduled {
        color: var(--blue);
      }

      /* Lời nhắc bên phải nhãn "Ngày đăng". Bỏ in nghiêng: đây là câu thông báo
         trạng thái, không phải chữ được nhấn mạnh. */
      #scheduleHint {
        font-style: normal;
        text-align: right;
      }

      main {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
      }
      .bar,
      .header {
        padding: 9px 13px;
        display: flex;
        gap: 7px;
        align-items: center;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        flex: none;
      }
      .col {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 14px 16px 60px;
        min-width: 0;
      }

      label {
        display: block;
        margin-bottom: 11px;
      }
      .label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 4px;
      }
      input,
      textarea {
        width: 100%;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 9px 10px;
        font: inherit;
      }
      input[type='checkbox'] {
        width: auto;
      }
      input:focus,
      textarea:focus {
        outline: 2px solid var(--blue);
        outline-offset: -1px;
      }
      button {
        background: var(--panel);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 9px 13px;
        font: inherit;
        cursor: pointer;
        min-height: 38px;
      }
      button.primary {
        background: #1f6feb;
        border-color: #1f6feb;
        font-weight: 600;
      }
      button.danger:hover {
        border-color: var(--red);
        color: var(--red);
      }
      button:disabled {
        opacity: 0.5;
      }
      .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px;
      }
      fieldset {
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 12px;
        margin: 0 0 12px;
      }
      legend {
        font-size: 12px;
        color: var(--muted);
        padding: 0 6px;
      }
      .checks {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }
      .checks label {
        display: flex;
        gap: 7px;
        align-items: center;
        margin: 0;
        font-size: 14px;
      }
      .counter.ok {
        color: var(--green);
      }
      .counter.bad {
        color: var(--red);
      }
      #toast {
        margin-left: auto;
        font-size: 12px;
        color: var(--muted);
      }
      #toast.ok {
        color: var(--green);
      }
      #toast.bad {
        color: var(--red);
      }
      .errbox:not(:empty) {
        border: 1px solid var(--red);
        background: #f8514915;
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 12px;
      }
      .errbox ul {
        margin: 0;
        padding-left: 18px;
      }
      /* --- Hàng đợi chủ đề ------------------------------------------------
         Bốn trạng thái, màu theo VIỆC CẦN LÀM chứ không theo thứ tự thời gian:
           vàng  đang chờ  — bình thường, chưa tới lượt
           xanh  đang soạn — máy đang làm, đừng đụng
           lục   đã soạn   — xong, không còn việc gì
           đỏ    thất bại  — CẦN người xem, đây là màu duy nhất đòi hành động */
      .q-queued {
        color: var(--yellow);
      }
      .q-drafting {
        color: var(--blue);
      }
      .q-done {
        color: var(--green);
      }
      .q-failed {
        color: var(--red);
      }
      select {
        width: 100%;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 8px 9px;
        font: inherit;
      }
      .note {
        color: var(--muted);
        font-size: 11px;
        margin-top: 3px;
      }

      /* Ô soạn phủ lớp tô màu — cùng kỹ thuật và cùng module với `pnpm admin`.
         Xem `scripts/lib/highlight-mdx.mjs`. */
      .editor-wrap {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
      }
      .editor-wrap:focus-within {
        outline: 2px solid var(--blue);
        outline-offset: -1px;
      }
      #hl,
      #content {
        margin: 0;
        padding: 10px 12px;
        font: 13px/1.7 var(--mono);
        white-space: pre-wrap;
        word-break: break-word;
        border: 0;
        tab-size: 2;
      }
      #hl {
        position: absolute;
        inset: 0;
        overflow: auto;
        pointer-events: none;
      }
      #content {
        position: relative;
        display: block;
        height: 55vh;
        min-height: 280px;
        background: transparent;
        color: transparent;
        caret-color: var(--text);
        border-radius: 0;
        resize: vertical;
      }
      .tok-heading {
        color: var(--blue);
        font-weight: 700;
      }
      .tok-tag {
        color: var(--purple);
      }
      .tok-code {
        color: var(--orange);
      }
      .tok-fence {
        color: var(--muted);
      }
      .tok-bold {
        font-weight: 700;
      }
      .tok-italic {
        font-style: italic;
      }
      .tok-link {
        color: var(--green);
      }
      .tok-quote {
        color: var(--muted);
        font-style: italic;
      }
      .tok-list {
        color: var(--yellow);
      }
      .toolbar {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-bottom: 6px;
      }
      .toolbar button {
        padding: 6px 9px;
        font-size: 12px;
        min-height: 34px;
      }
      .dropzone {
        border: 1px dashed var(--border);
        border-radius: 6px;
        padding: 10px;
        text-align: center;
        color: var(--muted);
        font-size: 12px;
        margin-top: 10px;
      }
      #btn-list {
        display: none;
      }

      @media (max-width: 900px) {
        .shell {
          grid-template-columns: 1fr;
          grid-template-rows: auto 1fr;
        }
        aside {
          border-right: 0;
          border-bottom: 1px solid var(--border);
          max-height: 42vh;
        }
        #btn-list {
          display: inline-block;
        }
        .row {
          grid-template-columns: 1fr;
        }
        #content {
          height: 48vh;
        }
      }
    </style>
  </head>

  <body>
    {
      !enabled ? (
        <div class="login">
          <h1>Chưa cấu hình</h1>
          <p>
            Trang quản trị cần <code>PUBLIC_SUPABASE_URL</code> và
            <code>PUBLIC_SUPABASE_ANON_KEY</code> lúc build. Đặt chúng thành GitHub Actions
            variables rồi deploy lại.
          </p>
        </div>
      ) : (
        <>
          <div class="login" id="screen-login">
            <h1>Quản trị nội dung</h1>
            <p>
              Đăng nhập được không có nghĩa là ghi được: quyền ghi do bảng <code>admins</code> trong
              database quyết định.
            </p>
            <form id="login-form">
              <label>
                <span class="label">
                  <span>Email</span>
                </span>
                <input type="email" id="email" autocomplete="username" required />
              </label>
              <label>
                <span class="label">
                  <span>Mật khẩu</span>
                </span>
                <input type="password" id="password" autocomplete="current-password" required />
              </label>
              <button class="primary" type="submit" style="width:100%">
                Đăng nhập
              </button>
              <p id="login-error" style="color:var(--red);margin-top:12px" />
            </form>
          </div>

          <div class="shell" id="screen-main" hidden>
            <aside>
              <div class="header">
                <button class="primary" id="btn-new">
                  + Bài mới
                </button>
                <button id="btn-queue">Chủ đề</button>
                <button id="btn-publish" title="Bắt đầu deploy ngay, khỏi chờ nhịp 20 phút">
                  Đăng ngay
                </button>
                <button id="btn-logout">Đăng xuất</button>
              </div>
              <div class="list" id="ds" />
            </aside>

            <main>
              <div class="bar">
                <button id="btn-list" aria-pressed="false">
                  ☰
                </button>
                <button class="primary" id="btn-save">
                  Lưu
                </button>
                <button id="btn-image">Ảnh…</button>
                <button class="danger" id="btn-delete">
                  Xoá
                </button>
                <span id="toast" />
              </div>

              <div class="col">
                <div id="errors" class="errbox" />

                <fieldset>
                  <legend>Bắt buộc</legend>
                  <label>
                    <span class="label">
                      <span>Tiêu đề</span>
                      <span class="counter" id="count-title" />
                    </span>
                    <input type="text" id="title" />
                  </label>
                  <label>
                    <span class="label">
                      <span>Slug — không đổi sau khi đã đăng</span>
                      <span class="counter" id="count-slug" />
                    </span>
                    <input type="text" id="slug" />
                    <span class="note" id="slug-note" />
                  </label>
                  <label>
                    <span class="label">
                      <span>Mô tả (meta description)</span>
                      <span class="counter" id="count-description" />
                    </span>
                    <textarea id="description" rows="3" />
                  </label>
                  <div class="row">
                    <label>
                      <span class="label">
                        <span>Tag, cách nhau bằng phẩy</span>
                        <span class="counter" id="count-tags" />
                      </span>
                      <input type="text" id="tags" />
                    </label>
                    <label>
                      <span class="label">
                        <span>Ngày đăng</span>
                        <em id="scheduleHint" />
                      </span>
                      <input type="date" id="published_at" />
                    </label>
                  </div>
                </fieldset>

                <fieldset>
                  <legend>Tuỳ chọn</legend>
                  <label>
                    <span class="label">
                      <span>Điểm chính — mỗi dòng một ý</span>
                      <span class="counter" id="count-takeaways" />
                    </span>
                    <textarea id="takeaways" rows="4" />
                  </label>
                  <div class="row">
                    <label>
                      <span class="label">
                        <span>Ảnh bìa (URL)</span>
                      </span>
                      <input type="text" id="cover_image" />
                    </label>
                    <label>
                      <span class="label">
                        <span>Mô tả ảnh bìa (alt)</span>
                      </span>
                      <input type="text" id="cover_alt" />
                    </label>
                  </div>
                  <div class="row">
                    <label>
                      <span class="label">
                        <span>Tên series</span>
                      </span>
                      <input type="text" id="series_name" />
                    </label>
                    <label>
                      <span class="label">
                        <span>Phần thứ</span>
                      </span>
                      <input type="number" id="series_part" min="1" />
                    </label>
                  </div>
                  <label>
                    <span class="label">
                      <span>Ngày cập nhật nội dung</span>
                    </span>
                    <input type="date" id="content_updated_at" />
                  </label>
                  <div class="checks">
                    <label>
                      <input type="checkbox" id="draft" /> Bài nháp
                    </label>
                    <label>
                      <input type="checkbox" id="featured" /> Nổi bật
                    </label>
                  </div>
                </fieldset>

                <div class="label">
                  <span>Thân bài (MDX)</span>
                  <span class="counter" id="count-content" />
                </div>

                <div class="toolbar" id="toolbar">
                  <button data-toast="## ">H2</button>
                  <button data-toast="### ">H3</button>
                  <button data-wrap="**">
                    <b>B</b>
                  </button>
                  <button data-wrap="_">
                    <i>I</i>
                  </button>
                  <button data-wrap="`">code</button>
                  <button data-action="link">link</button>
                  <button data-toast="- ">• ds</button>
                  <button data-action="fence">```</button>
                  <button data-action="callout">Callout</button>
                  <button data-action="steps">Steps</button>
                  <button data-action="figure">Figure</button>
                  <button data-action="pullquote">PullQuote</button>
                </div>

                <div class="editor-wrap">
                  <pre id="hl" aria-hidden="true">
                    <code />
                  </pre>
                  <textarea id="content" spellcheck="false" />
                </div>

                <div class="dropzone" id="dropzone">
                  Kéo ảnh vào đây, hoặc bấm “Ảnh…”
                </div>
                <p class="note" style="margin-top:14px">
                  Lưu là xong — nội dung vào database ngay. Site tĩnh nên bài lên trong vòng 20
                  phút, do workflow “Auto publish” chạy. Cần lên ngay thì bấm Run workflow ở tab
                  Actions.
                </p>
              </div>
            </main>
          </div>

          <div class="shell" id="screen-queue" hidden />

          <input type="file" id="file-input" accept="image/*" multiple hidden />
        </>
      )
    }

    <script
      define:vars={{
        SUPABASE_URL: ENV.publicSupabaseUrl,
        KEY: ENV.publicSupabaseAnonKey,
        LIMITS,
      }}
      is:inline
    >
      window.__ADMIN = { SUPABASE_URL, KEY, LIMITS };
    </script>

    <script>
      import { highlightMdx, MDX_SNIPPETS } from '../../scripts/lib/highlight-mdx.mjs';
      import {
        validatePost,
        normalizePost,
        postStatus,
        STATUS_LABELS,
        today,
        slugify,
      } from '../../scripts/lib/post.mjs';
      import { mountQueueUi } from '../../scripts/lib/queue-ui.mjs';

      const cfg = (window as unknown as { __ADMIN?: Record<string, unknown> }).__ADMIN;
      const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
      const val = (id: string) => ($(id) as HTMLInputElement | null)?.value ?? '';

      if (cfg) {
        const SUPABASE_URL = cfg['SUPABASE_URL'] as string;
        const KEY = cfg['KEY'] as string;
        const G = cfg['LIMITS'] as Record<string, number>;
        const SESSION_KEY = 'admin-session';

        let session: { access_token: string; refresh_token: string } | null = null;
        let posts: Record<string, unknown>[] = [];
        let editingSlug: string | null = null;

        // --- Gọi Supabase ---------------------------------------------------
        const authHeaders = () => ({
          apikey: KEY,
          Authorization: `Bearer ${session?.access_token ?? KEY}`,
          'Content-Type': 'application/json',
        });

        function toast(chu: string, loai = '') {
          const el = $('toast');
          if (el) {
            el.textContent = chu;
            el.className = loai;
          }
        }

        /**
         * Access token của Supabase sống 1 giờ. Viết một bài dài là chắc chắn hết
         * hạn giữa lúc viết, và lúc đó mọi lần lưu sẽ trả 401 — mất bài. Nên làm
         * mới bằng refresh token trước khi gọi, khi gặp 401.
         */
        async function api(
          path: string,
          options: RequestInit = {},
          retry = true,
        ): Promise<Response> {
          // Gộp header của caller lên trên, không ghi đè bằng `authHeaders()`.
          //
          // Bản trước viết `headers: authHeaders()` nên mọi header caller truyền vào bị bỏ
          // lặng lẽ. Không có lỗi nào để thấy — chỉ là `Prefer` không bao giờ tới
          // được PostgREST, và đó là một nửa nguyên nhân của lỗi trùng slug.
          const res = await fetch(`${SUPABASE_URL}${path}`, {
            ...options,
            headers: { ...authHeaders(), ...((options.headers as Record<string, string>) ?? {}) },
          });
          if (res.status !== 401 || !retry || !session) return res;

          const r = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=refresh_token`, {
            method: 'POST',
            headers: { apikey: KEY, 'Content-Type': 'application/json' },
            body: JSON.stringify({ refresh_token: session.refresh_token }),
          });
          if (!r.ok) {
            logout();
            return res;
          }
          const moi = await r.json();
          session = { access_token: moi.access_token, refresh_token: moi.refresh_token };
          localStorage.setItem(SESSION_KEY, JSON.stringify(session));
          return api(path, options, false);
        }

        function logout() {
          session = null;
          localStorage.removeItem(SESSION_KEY);
          // Ẩn CẢ HAI màn hình. Thiếu `screen-queue` thì đăng xuất xong vẫn còn thấy
          // danh sách chủ đề trên màn hình — dữ liệu đã nạp trước đó không tự biến mất.
          $('screen-main')!.hidden = true;
          $('screen-queue')!.hidden = true;
          $('screen-login')!.hidden = false;
        }

        // --- Tô màu ---------------------------------------------------------
        const hlCode = $('hl')!.firstElementChild!;
        const editor = () => $('content') as HTMLTextAreaElement;

        function renderHighlight() {
          hlCode.innerHTML = highlightMdx(editor().value);
          $('hl')!.scrollTop = editor().scrollTop;
        }

        function replaceRange(a: number, b: number, chuoi: string) {
          const t = editor();
          t.setRangeText(chuoi, a, b, 'end');
          t.focus();
          t.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function wrap(dau2: string) {
          const t = editor();
          const { selectionStart: a, selectionEnd: b, value: v } = t;
          replaceRange(a, b, `${dau2}${v.slice(a, b)}${dau2}`);
          if (a === b) t.selectionStart = t.selectionEnd = a + dau2.length;
        }

        function addPrefix(tt2: string) {
          const t = editor();
          const v = t.value;
          const d = v.lastIndexOf('\n', t.selectionStart - 1) + 1;
          const c =
            v.indexOf('\n', t.selectionEnd) === -1 ? v.length : v.indexOf('\n', t.selectionEnd);
          const khoi = v
            .slice(d, c)
            .split('\n')
            .map((x) => (x.startsWith(tt2) ? x.slice(tt2.length) : tt2 + x))
            .join('\n');
          replaceRange(d, c, khoi);
        }

        // --- Đếm ------------------------------------------------------------
        function counter(id: string, n: number, min: number, max: number) {
          const el = $(`counter-${id}`);
          if (!el) return;
          el.textContent = `${n} / ${min}–${max}`;
          el.className = `counter ${n >= min && n <= max ? 'ok' : 'bad'}`;
        }

        /**
         * Viết lời nhắc vào `#scheduleHint`, ngay bên phải nhãn "Ngày đăng".
         *
         * Ô ngày đăng là một cái HẸN, không phải chữ để hiển thị: để ngày mai thì bài
         * nằm im tới đúng ngày đó rồi tự lên. Không nói ra thì không ai đoán được —
         * tính năng không ai biết là tính năng không tồn tại.
         *
         * Ba câu, khớp với ba trạng thái trong `postStatus`:
         *   nháp            — ngày chưa có tác dụng, bài không lên dù để ngày nào.
         *   tương lai       — đang hẹn; nói rõ còn mấy ngày và rằng KHÔNG cần làm gì.
         *   hôm nay/quá khứ — sẽ lên ở lần đồng bộ kế tiếp.
         *
         * Lưu ý cho người sửa sau: markup của trang này nằm trong một biểu thức
         * ternary `{!enabled ? (...) : (...)}`, tức là JSX. Đừng đặt `<!-- -->` vào đó —
         * prettier sẽ ném SyntaxError và CI đỏ. Chú thích về markup viết ở đây.
         */
        function updateScheduleHint() {
          const el = $('scheduleHint');
          if (!el) return;

          const date = val('published_at');
          const draft = ($('draft') as HTMLInputElement | null)?.checked;

          if (draft) {
            el.textContent = 'đang là nháp — ngày chưa có tác dụng';
            el.className = 'draft';
            return;
          }
          if (!date) {
            el.textContent = '';
            return;
          }

          const homNay = today();
          if (date > homNay) {
            const days = Math.round(
              (Date.parse(`${date}T00:00:00Z`) - Date.parse(`${homNay}T00:00:00Z`)) / 86400000,
            );
            el.textContent = `đặt lịch — tự lên sau ${days} ngày, không cần làm gì`;
            el.className = 'scheduled';
          } else {
            el.textContent = 'sẽ lên site ở lần đồng bộ kế tiếp (~20 phút)';
            el.className = 'published';
          }
        }

        function updateCounters() {
          counter('title', val('title').trim().length, 1, G['titleToiDa']!);
          counter(
            'description',
            val('description').trim().length,
            G['descriptionMin']!,
            G['descriptionMax']!,
          );
          counter(
            'tags',
            val('tags')
              .split(',')
              .filter((t) => t.trim()).length,
            G['tagsMin']!,
            G['tagsMax']!,
          );

          const tk = val('takeaways')
            .split('\n')
            .filter((t) => t.trim());
          const okTk =
            tk.length === 0 || (tk.length >= G['takeawaysMin']! && tk.length <= G['takeawaysMax']!);
          const elTk = $('count-takeaways')!;
          elTk.textContent = `${tk.length} dòng`;
          elTk.className = `counter ${okTk ? 'ok' : 'bad'}`;

          const chu = editor().value.trim().split(/\s+/).filter(Boolean).length;
          $('count-content')!.textContent =
            `${chu.toLocaleString('vi-VN')} từ · ~${Math.max(1, Math.round(chu / 200))} phút`;

          updateScheduleHint();

          const slug = val('slug').trim();
          const hopLe = /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug);
          $('count-slug')!.textContent = slug ? (hopLe ? 'hợp lệ' : 'bad định dạng') : '';
          $('count-slug')!.className = `counter ${slug && hopLe ? 'ok' : slug ? 'bad' : ''}`;
          $('slug-note')!.textContent = slug ? `URL: /blog/${slug}` : '';
        }

        // --- Form -----------------------------------------------------------
        function readForm() {
          return {
            slug: val('slug'),
            title: val('title'),
            description: val('description'),
            content: editor().value,
            published_at: val('published_at') || null,
            content_updated_at: val('content_updated_at') || null,
            tags: val('tags')
              .split(',')
              .map((t) => t.trim())
              .filter(Boolean),
            takeaways: val('takeaways')
              .split('\n')
              .map((t) => t.trim())
              .filter(Boolean),
            series_name: val('series_name'),
            series_part: val('series_part'),
            cover_image: val('cover_image'),
            cover_alt: val('cover_alt'),
            draft: ($('draft') as HTMLInputElement).checked,
            featured: ($('featured') as HTMLInputElement).checked,
          };
        }

        function fillForm(b: Record<string, any> | null) {
          const setField = (id: string, v: unknown) => {
            ($(id) as HTMLInputElement).value = v == null ? '' : String(v);
          };
          setField('title', b?.title);
          setField('slug', b?.slug);
          setField('description', b?.description);
          setField('content', b?.content);
          // `today()` chứ không phải `toISOString()`: cái sau cho ra ngày UTC,
          // nên mở form lúc 6 giờ sáng ở Việt Nam sẽ điền lùi mất một ngày.
          setField('published_at', b?.published_at ?? today());
          setField('content_updated_at', b?.content_updated_at);
          setField('tags', (b?.tags ?? []).join(', '));
          setField('takeaways', (b?.takeaways ?? []).join('\n'));
          setField('series_name', b?.series_name);
          setField('series_part', b?.series_part);
          setField('cover_image', b?.cover_image);
          setField('cover_alt', b?.cover_alt);
          ($('draft') as HTMLInputElement).checked = b ? Boolean(b.draft) : true;
          ($('featured') as HTMLInputElement).checked = Boolean(b?.featured);

          editingSlug = (b?.slug as string) ?? null;
          ($('btn-delete') as HTMLButtonElement).disabled = !b;
          $('errors')!.innerHTML = '';
          updateCounters();
          renderHighlight();
          renderList();
        }

        function renderList() {
          $('ds')!.innerHTML = posts
            .map((b: any) => {
              const t = String(b.title).replace(/</g, '&lt;');
              return `<div class="item" data-slug="${b.slug}" ${b.slug === editingSlug ? 'aria-current="true"' : ''}>
                <b>${t}</b>
                <small><span class="badge ${postStatus(b)}">${STATUS_LABELS[postStatus(b)]}</span>${b.published_at ?? ''}</small>
              </div>`;
            })
            .join('');
          for (const el of $('ds')!.querySelectorAll<HTMLElement>('.item')) {
            el.onclick = () => {
              const b = posts.find((x: any) => x.slug === el.dataset['slug']);
              if (b) fillForm(b as any);
              document.querySelector('.col')?.scrollTo(0, 0);
            };
          }
        }

        async function loadPosts() {
          const r = await api('/rest/v1/posts?select=*&order=published_at.desc');
          if (!r.ok) {
            toast('Không tải được danh sách', 'bad');
            return;
          }
          posts = await r.json();
          renderList();
        }

        async function save() {
          const post = normalizePost(readForm());
          const errors = validatePost(post);
          if (errors.length > 0) {
            $('errors')!.innerHTML =
              `<b>Chưa lưu được:</b><ul>${errors.map((l: any) => `<li>${l.thongDiep}</li>`).join('')}</ul>`;
            toast('Có lỗi cần sửa', 'bad');
            return;
          }

          toast('Đang lưu…');

          /*
            Sửa bài thì PATCH, tạo bài mới thì POST. Hai lệnh khác nhau, không phải
            một lệnh upsert dùng cho cả hai.

            Bản trước gọi `POST /posts?on_conflict=slug` và tưởng đó là upsert. Không
            phải: PostgREST chỉ upsert khi có thêm header `Prefer:
            resolution=merge-duplicates`, mà `api()` lúc đó đang note đè header của
            caller nên nó không wrap giờ tới. Kết quả là INSERT thuần, và mọi lần lưu
            một bài đã có đều trả 409 `posts_slug_key`. Lỗi anh gặp lúc sửa ảnh bài cũ.

            Vá bằng cách thêm header đó thì hết 409 nhưng che một lỗi khác: upsert
            khớp theo slug, nên ĐỔI slug của bài cũ sẽ tạo một bài MỚI và để bài cũ
            nằm lại — hai bài trùng nội dung, không có gì báo. PATCH theo slug gốc thì
            đổi slug là đổi tên thật.

            Tách hai lệnh còn cho hai thất bại đúng nghĩa: tạo bài mới mà slug đã có
            thì 409 (đúng — đừng note đè bài người khác), còn sửa bài đã bị xoá ở nơi
            khác thì 0 dòng thay vì lặng lẽ tạo lại.
          */
          const originalSlug = editingSlug;
          const isEditing = originalSlug !== null;

          const r = await api(
            isEditing
              ? `/rest/v1/posts?slug=eq.${encodeURIComponent(originalSlug)}`
              : '/rest/v1/posts',
            {
              method: isEditing ? 'PATCH' : 'POST',
              // `return=representation` để đếm được số dòng thật sự đổi. RLS lọc hết
              // dòng thì PostgREST vẫn trả 2xx — mã trả về KHÔNG nói lên điều gì.
              headers: { Prefer: 'return=representation' },
              body: JSON.stringify(post),
            },
          );

          if (!r.ok) {
            const detail = await r.text();
            const duplicateSlug = detail.includes('posts_slug_key');
            $('errors')!.innerHTML = duplicateSlug
              ? `<b>Slug <code>${post.slug}</code> đã có bài khác dùng.</b><ul><li>Đổi slug, hoặc mở bài đang dùng slug đó ra sửa.</li></ul>`
              : `<b>Database từ chối (HTTP ${r.status}):</b><ul><li>${detail.slice(0, 300)}</li></ul>`;
            toast(r.status === 403 ? 'Tài khoản này không có quyền note' : 'Lưu thất bại', 'bad');
            return;
          }

          // 2xx nhưng 0 dòng: RLS đã lọc, hoặc bài không còn tồn tại. Không báo thì
          // người viết đóng tab với niềm tin là đã lưu.
          const rows = (await r.json().catch(() => [])) as unknown[];
          if (isEditing && rows.length === 0) {
            $('errors')!.innerHTML =
              '<b>Không có dòng nào được sửa.</b><ul><li>Bài này có thể đã bị xoá, hoặc tài khoản không có quyền note. Tải lại danh sách rồi thử lại.</li></ul>';
            toast('Chưa lưu được', 'bad');
            await loadPosts();
            return;
          }

          $('errors')!.innerHTML = '';
          editingSlug = post.slug;
          await loadPosts();
          toast('Đã lưu — site cập nhật trong 20 phút', 'ok');
        }

        // --- Ảnh ------------------------------------------------------------
        async function uploadImages(files: File[]) {
          for (const f of files) {
            const ext = (f.name.match(/\.[a-z0-9]+$/i)?.[0] ?? '').toLowerCase();
            const base = slugify(f.name.slice(0, f.name.length - ext.length)) || 'image';
            const key = `${new Date().getFullYear()}/${base}${ext}`;

            toast(`Đang tải ${f.name}…`);

            // KHÔNG gửi `x-upsert`: endpoint POST của Storage từ chối header đó
            // bằng HTTP 400 với body rỗng — đã đo từng header để tìm ra. `x-upsert`
            // chỉ dùng cho luồng PUT của SDK.
            //
            // `max-age=31536000` để ảnh được cache một năm. Supabase mặc định trả
            // `no-cache`, tức mỗi người đọc tải lại ảnh từ đầu.
            const r = await fetch(`${SUPABASE_URL}/storage/v1/object/anh-blog/${key}`, {
              method: 'POST',
              headers: {
                apikey: KEY,
                Authorization: `Bearer ${session?.access_token}`,
                'Content-Type': f.type,
                'Cache-Control': 'max-age=31536000',
              },
              body: f,
            });

            if (!r.ok) {
              // Trùng tên thì nói rõ, đừng để người dùng đoán. Cố tình KHÔNG tự ghi
              // đè: một bài khác có thể đang dùng đúng ảnh đó.
              toast(
                r.status === 409
                  ? `Đã có ảnh tên "${key}${ext}" — đổi tên file rồi thử lại.`
                  : r.status === 403
                    ? 'Tài khoản này không có quyền tải ảnh lên.'
                    : `Không tải được ảnh (HTTP ${r.status})`,
                'bad',
              );
              continue;
            }

            const url = `${SUPABASE_URL}/storage/v1/object/public/anh-blog/${key}`;
            if (!val('cover_image')) {
              ($('cover_image') as HTMLInputElement).value = url;
              toast('Đặt làm ảnh bìa — nhớ điền alt', 'ok');
              $('cover_alt')!.focus();
            } else {
              const t = editor();
              replaceRange(
                t.selectionStart,
                t.selectionEnd,
                `\n<Figure\n  src="${url}"\n  alt=""\n  caption=""\n/>\n`,
              );
              toast('Đã chèn <Figure> — nhớ điền alt', 'ok');
            }
          }
        }

        /* --- Hàng đợi chủ đề ------------------------------------------------

           Màn hình này do `lib/queue-ui.mjs` dựng, dùng CHUNG với `pnpm admin`. Ở đây
           chỉ tiêm cách nói chuyện với database: gọi thẳng REST bằng JWT.

           `raw: true` cho `save` là đường dành cho nút "Thử lại" — nó gửi đúng những
           cột cần đổi (status, attempts, last_error) chứ không gửi cả form.
        */
        let queueUi: { refresh: () => Promise<void> } | null = null;

        const queueDb = {
          async list() {
            const r = await api('/rest/v1/content_queue?select=*&order=publish_on.asc');
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json();
          },

          async save(item: Record<string, unknown>, id: string | null, opts?: { raw?: boolean }) {
            const body = opts?.raw ? item : item;
            const r = await api(
              id ? `/rest/v1/content_queue?id=eq.${id}` : '/rest/v1/content_queue',
              {
                method: id ? 'PATCH' : 'POST',
                headers: { Prefer: 'return=representation' },
                body: JSON.stringify(body),
              },
            );
            const rows = await r.json().catch(() => []);
            if (!r.ok) throw new Error(String(rows?.message ?? `HTTP ${r.status}`));
            // 2xx với 0 dòng nghĩa là RLS đã lọc — cùng cái bẫy đã gặp ở bảng posts.
            if (id && Array.isArray(rows) && rows.length === 0) {
              throw new Error('Không có dòng nào được sửa — chủ đề có thể đã bị xoá.');
            }
            return Array.isArray(rows) ? rows[0] : rows;
          },

          async remove(id: string) {
            const r = await api(`/rest/v1/content_queue?id=eq.${id}`, { method: 'DELETE' });
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
          },
        };

        function showQueue(show: boolean) {
          $('screen-main')!.hidden = show;
          $('screen-queue')!.hidden = !show;

          // Quay về thì TẢI LẠI danh sách bài. Lý do cụ thể: thứ hay xảy ra giữa hai
          // lần mở màn hình này là trình soạn bài tự động vừa sinh ra một bài nháp mới.
          // Không tải lại thì nó không xuất hiện, và người dùng tưởng chưa soạn được.
          if (!show) {
            void loadPosts();
            return;
          }

          // Gắn một lần rồi giữ lại: dựng lại mỗi lần mở là mất chủ đề đang sửa.
          if (!queueUi) {
            queueUi = mountQueueUi($('screen-queue')!, {
              db: queueDb,
              toast,
              today: today(),
              onExit: () => showQueue(false),
            });
          }
          void queueUi.refresh();
        }

        $('btn-queue')!.onclick = () => showQueue(true);

        /* --- Đăng ngay --------------------------------------------------------

           Site là tĩnh, nên publish nghĩa là build lại — không có cách nào về 0 giây.
           Đo trên repo này: sync+commit ~30s rồi build+deploy ~35s, tức khoảng 60–90 giây.

           Nút này bỏ phần CHỜ: thay vì cron 20 phút hỏi thăm database, database gọi thẳng
           GitHub qua `rpc/request_deploy` (pg_net, token trong Supabase Vault — không có bí
           mật nào trong trang này).

           Cron vẫn giữ, vì nó GỘP: sửa một bài là nhiều lần Lưu, và không ai muốn 10 lần
           deploy cho 10 lần Lưu.
        */
        $('btn-publish')!.onclick = async () => {
          const btn = $('btn-publish') as HTMLButtonElement;
          btn.disabled = true;
          toast('Đang gọi deploy…');

          try {
            const r = await api('/rest/v1/rpc/request_deploy', {
              method: 'POST',
              body: JSON.stringify({ reason: 'bấm Đăng ngay' }),
            });
            const result = String(await r.text()).replace(/^"|"$/g, '');

            if (!r.ok) {
              toast(`Không gọi được deploy (HTTP ${r.status})`, 'bad');
            } else if (result === 'qua_som') {
              toast('Vừa có một lần deploy — đợi nó xong đã', 'bad');
            } else if (result === 'chua_cau_hinh') {
              toast('Chưa cất token GitHub: chạy `pnpm deploy:token`', 'bad');
            } else {
              toast('Đã gọi deploy — bài lên trong khoảng 1–2 phút', 'ok');
            }
          } catch (e) {
            toast(`Lỗi: ${e instanceof Error ? e.message : String(e)}`, 'bad');
          } finally {
            // Mở lại sau 60s, khớp `min_gap_seconds` của RPC: bấm sớm hơn chỉ nhận `qua_som`.
            setTimeout(() => {
              btn.disabled = false;
            }, 60_000);
          }
        };

        // --- Đăng nhập ------------------------------------------------------
        async function restoreSession() {
          $('screen-login')!.hidden = true;
          $('screen-main')!.hidden = false;
          await loadPosts();
          fillForm(null);
        }

        $('login-form')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          const errorBox = $('login-error')!;
          errorBox.textContent = 'Đang đăng nhập…';

          const r = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
            method: 'POST',
            headers: { apikey: KEY, 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: val('email'), password: val('password') }),
          });

          if (!r.ok) {
            errorBox.textContent = 'Email hoặc mật khẩu không đúng.';
            return;
          }

          const d = await r.json();
          session = { access_token: d.access_token, refresh_token: d.refresh_token };
          localStorage.setItem(SESSION_KEY, JSON.stringify(session));
          errorBox.textContent = '';
          await restoreSession();
        });

        $('btn-logout')!.onclick = logout;
        $('btn-save')!.onclick = save;
        $('btn-new')!.onclick = () => {
          fillForm(null);
          $('title')!.focus();
        };
        $('btn-delete')!.onclick = async () => {
          if (!editingSlug) return;
          if (!confirm(`Xoá hẳn bài "${editingSlug}"?\n\nKhông hoàn lại được.`)) return;
          const r = await api(`/rest/v1/posts?slug=eq.${encodeURIComponent(editingSlug)}`, {
            method: 'DELETE',
          });
          if (!r.ok) {
            toast('Không xoá được', 'bad');
            return;
          }
          await loadPosts();
          fillForm(null);
          toast('Đã xoá', 'ok');
        };
        $('btn-list')!.onclick = () => {
          const a = document.querySelector('aside')!;
          a.hidden = !a.hidden;
        };
        $('btn-image')!.onclick = () => ($('file-input') as HTMLInputElement).click();
        ($('file-input') as HTMLInputElement).onchange = (e) =>
          uploadImages([...((e.target as HTMLInputElement).files ?? [])]);

        const dropzone = $('dropzone')!;
        for (const su of ['dragenter', 'dragover'])
          dropzone.addEventListener(su, (e) => e.preventDefault());
        dropzone.addEventListener('drop', (e) => {
          e.preventDefault();
          const dt = (e as DragEvent).dataTransfer;
          uploadImages([...(dt?.files ?? [])].filter((f) => f.type.startsWith('image/')));
        });

        $('toolbar')!.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('button');
          if (!b) return;
          e.preventDefault();
          if (b.dataset['toast']) return addPrefix(b.dataset['toast']);
          if (b.dataset['wrap']) return wrap(b.dataset['wrap']);
          const action = b.dataset['action'];
          if (action === 'link') {
            const t = editor();
            const picked = t.value.slice(t.selectionStart, t.selectionEnd) || 'chữ hiện ra';
            return replaceRange(t.selectionStart, t.selectionEnd, `[${picked}](https://)`);
          }
          const snippet = (MDX_SNIPPETS as Record<string, string>)[action ?? ''];
          if (snippet) {
            const t = editor();

            /*
              Chèn SAU phần đang chọn, không thay thế nó.

              Bản trước gọi `replaceRange(selectionStart, selectionEnd, snippet)`, nên chọn
              một đoạn rồi bấm Callout là đoạn đó BIẾN MẤT, thay bằng template. Không
              có hỏi lại, và sau khi Lưu thì không hoàn lại được.

              Đó không phải chuyện giả định: chính tôi đã xoá mất câu mở của bài
              `cache-http-ba-tang` đúng theo cách này — chọn "Tôi từng", bấm B, rồi
              bấm Callout khi phần chọn còn nguyên. Bài đã lên site với một khối
              Callout mẫu ở đầu suốt mấy giờ, phải lấy lại từ commit đầu tiên.

              Nút đậm/nghiêng và nút link thì BAO quanh phần chọn — đúng rồi, giữ
              nguyên. Chỉ khối component mới cần đổi.
            */
            // Chèn ở CUỐI DÒNG chứa con trỏ, không phải ngay tại con trỏ.
            //
            // Khối MDX phải nằm giữa hai đoạn văn. Chèn đúng vị trí con trỏ thì nó cắt
            // đôi câu đang viết, và nếu con trỏ nằm trong cặp `**` thì cắt đôi cả cặp
            // đó — không mất chữ, nhưng ra một mớ không ai muốn đọc.
            const nextNewline = t.value.indexOf('\n', t.selectionEnd);
            const pos = nextNewline === -1 ? t.value.length : nextNewline;

            // Mọi mẫu trong `MDX_SNIPPETS` đã tự mở đầu bằng '\n'. Thêm đúng MỘT '\n' nữa
            // để có dòng trống phía trên, và chỉ khi phía trước chưa sẵn là dòng trống.
            const before = t.value.slice(0, pos);
            const counter = before === '' || before.endsWith('\n') ? '' : '\n';

            replaceRange(pos, pos, counter + snippet);
          }
        });

        for (const id of ['title', 'slug', 'description', 'tags', 'takeaways', 'content'])
          $(id)!.addEventListener('input', updateCounters);

        // Ngày đăng và ô nháp cũng phải gọi lại — cả hai đổi câu ở `#scheduleHint`. Thiếu
        // hai dòng này thì lời nhắc "đặt lịch" chỉ đúng lúc mới mở form rồi đứng im.
        $('published_at')!.addEventListener('input', updateCounters);
        $('draft')!.addEventListener('change', updateCounters);
        $('content')!.addEventListener('input', renderHighlight);
        $('content')!.addEventListener('scroll', () => {
          $('hl')!.scrollTop = editor().scrollTop;
        });
        $('title')!.addEventListener('input', () => {
          if (!editingSlug) ($('slug') as HTMLInputElement).value = slugify(val('title'));
          updateCounters();
        });

        document.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            if (!$('screen-main')!.hidden) save();
          }
        });

        // Có phiên cũ trong localStorage thì vào luôn, không phải đăng nhập lại.
        const store = localStorage.getItem(SESSION_KEY);
        if (store) {
          try {
            session = JSON.parse(store);
            void restoreSession();
          } catch {
            localStorage.removeItem(SESSION_KEY);
          }
        }
      }
    </script>
  </body>
</html>
