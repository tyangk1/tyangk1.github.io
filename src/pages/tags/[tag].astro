---
import type { GetStaticPaths } from 'astro';
import { getPublishedPosts, collectTags, postsByTag, type Post } from '~/utils/posts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import TagPill from '~/components/TagPill.astro';
import type { TagCount } from '~/utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, tags, items: postsByTag(posts, tag.slug) },
  }));
};

interface Props {
  tag: TagCount;
  tags: TagCount[];
  items: Post[];
}

const { tag, tags, items } = Astro.props;
---

<BaseLayout
  title={`Chủ đề: ${tag.name}`}
  description={`Tất cả ${items.length} bài viết thuộc chủ đề ${tag.name} trên blog này, sắp xếp theo thứ tự mới nhất trước để bạn đọc được nội dung cập nhật nhất.`}
>
  <div class="wrap py-12">
    <nav aria-label="Đường dẫn" class="text-sm text-muted">
      <a href="/tags" class="tap py-1 transition-colors hover:text-accent">Chủ đề</a>
      <span aria-hidden="true"> / </span>
      <span>{tag.name}</span>
    </nav>

    <p class="eyebrow mt-4">Chủ đề</p>
    <h1 class="display-xl mt-2 text-4xl">{tag.name}</h1>
    <p class="mt-3 text-muted">{items.length} bài viết.</p>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Chủ đề khác">
      {
        tags.map((other) => (
          <li>
            <TagPill name={other.name} count={other.count} active={other.slug === tag.slug} />
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
