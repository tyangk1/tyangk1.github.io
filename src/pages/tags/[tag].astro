---
import { getPublishedPosts, collectTags, postsByTag } from '~/utils/posts';
import { CACHE_LIST, CACHE_NOT_FOUND, setCache } from '~/lib/cache';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import TagPill from '~/components/TagPill.astro';

/*
  Chạy lúc có request, nên KHÔNG còn `getStaticPaths`.

  Đây là lý do quan trọng hơn "để bài mới hiện ra": với `getStaticPaths`, tập trang tag
  được đóng băng lúc build. Một bài mới mang tag CHƯA TỪNG dùng thì trang tag đó không
  tồn tại — và chính bài đó lại có link trỏ tới nó. Tức là đăng một bài với tag mới là
  tự tạo ra một link 404 trên trang bài của mình.
*/
export const prerender = false;

const posts = await getPublishedPosts();
const tags = collectTags(posts);
const tag = tags.find((t) => t.slug === Astro.params.tag);

/*
  Tag không có bài nào thì 404, không phải trang trống.

  Cố ý đối chiếu với tag CÓ THẬT thay vì nhận mọi giá trị params rồi hiện danh sách rỗng:
  cách kia biến mọi chuỗi gõ bừa thành một URL trả 200, và Google sẽ index chúng.
*/
if (!tag) {
  setCache(Astro.response, CACHE_NOT_FOUND);
  return Astro.rewrite('/404');
}

setCache(Astro.response, CACHE_LIST);

const items = postsByTag(posts, tag.slug);
---

<BaseLayout
  title={`Chủ đề: ${tag.name}`}
  description={`Tất cả ${items.length} bài viết thuộc chủ đề ${tag.name} trên blog này, sắp xếp theo thứ tự mới nhất trước để bạn đọc được nội dung cập nhật nhất.`}
>
  <div class="wrap py-12">
    <nav aria-label="Đường dẫn" class="text-sm text-muted">
      <a href="/tags" class="tap py-1 transition-colors hover:text-accent">Chủ đề</a>
      <span aria-hidden="true"> / </span>
      <span>{tag.name}</span>
    </nav>

    <p class="eyebrow mt-4">Chủ đề</p>
    <h1 class="display-xl mt-2 text-4xl">{tag.name}</h1>
    <p class="mt-3 text-muted">{items.length} bài viết.</p>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Chủ đề khác">
      {
        tags.map((other) => (
          <li>
            <TagPill name={other.name} count={other.count} active={other.slug === tag.slug} />
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
