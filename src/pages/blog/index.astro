---
import { SITE } from '~/site.config';
import { getPublishedPosts, collectTags } from '~/utils/posts';
import { CACHE_DANH_SACH, datCache } from '~/lib/cache';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import Pagination from '~/components/Pagination.astro';
import TagPill from '~/components/TagPill.astro';
import { blogPageHref } from '~/lib/routes';

export const prerender = false;

datCache(Astro.response, CACHE_DANH_SACH);

const posts = await getPublishedPosts();
const tags = collectTags(posts);

const lastPage = Math.max(1, Math.ceil(posts.length / SITE.postsPerPage));
const items = posts.slice(0, SITE.postsPerPage);
---

<BaseLayout
  title="Bài viết"
  description="Toàn bộ bài viết trên blog, sắp xếp mới nhất trước. Chủ đề xoay quanh phát triển web, kiến trúc hệ thống và cách làm việc hiệu quả hơn mỗi ngày."
>
  <div class="wrap py-12">
    <p class="eyebrow">Lưu trữ</p>
    <h1 class="display-xl mt-3 text-4xl">Bài viết</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      {posts.length} bài, mới nhất trước. Lọc theo chủ đề hoặc <a
        href="/search"
        class="text-accent hover:underline">tìm kiếm</a
      >.
    </p>

    {
      tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Lọc theo chủ đề">
          {tags.map((tag) => (
            <li>
              <TagPill name={tag.name} count={tag.count} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={1} lastPage={lastPage} hrefFor={blogPageHref} />
  </div>
</BaseLayout>
