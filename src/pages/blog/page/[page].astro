---
import { SITE } from '~/site.config';
import { getPublishedPosts } from '~/utils/posts';
import { CACHE_DANH_SACH, CACHE_KHONG_TIM_THAY, datCache } from '~/lib/cache';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import Pagination from '~/components/Pagination.astro';
import { blogPageHref } from '~/lib/routes';

export const prerender = false;

const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / SITE.postsPerPage));

/*
  `page` phải là SỐ NGUYÊN từ 2 tới trang cuối, kiểm cả ba điều kiện.

  Trang 1 nằm ở `/blog` (xem `blog/index.astro`), nên `/blog/page/1` phải 404 — để hai
  URL không cùng tồn tại với nội dung y hệt, thứ Google coi là trùng lặp.

  Với `getStaticPaths` thì tập trang hợp lệ tự đóng, không cần kiểm gì. Chuyển sang chạy
  lúc request là mất hàng rào đó: `/blog/page/999`, `/blog/page/-1`, `/blog/page/2.5` và
  `/blog/page/abc` đều tới được đây. Không kiểm thì chúng trả 200 kèm danh sách rỗng, và
  đó là vô số URL rác cho Google index.
*/
const page = Number(Astro.params.page);
const hopLe = Number.isInteger(page) && page >= 2 && page <= lastPage;

if (!hopLe) {
  datCache(Astro.response, CACHE_KHONG_TIM_THAY);
  return Astro.rewrite('/404');
}

datCache(Astro.response, CACHE_DANH_SACH);

const items = posts.slice((page - 1) * SITE.postsPerPage, page * SITE.postsPerPage);
---

<BaseLayout
  title={`Bài viết — trang ${page}`}
  description={`Trang ${page} trong danh sách bài viết của blog. Các bài về phát triển web, kiến trúc hệ thống và cách làm việc, sắp xếp theo thứ tự mới nhất trước.`}
>
  <div class="wrap py-12">
    <p class="eyebrow">Lưu trữ</p>
    <h1 class="display-xl mt-3 text-4xl">
      Bài viết <span class="text-muted">— trang {page}</span>
    </h1>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={page} lastPage={lastPage} hrefFor={blogPageHref} />
  </div>
</BaseLayout>
