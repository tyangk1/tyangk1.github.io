# ---------------------------------------------------------------------------
# Sao chép file này thành `.env` rồi điền giá trị thật.
# ---------------------------------------------------------------------------

# ===========================================================================
#  DATABASE (Supabase) — BẮT BUỘC
#  Nội dung bài viết và dự án nằm trong đây. Đây là nguồn sự thật.
# ===========================================================================

# Chạy cục bộ:  pnpm db:start  → CLI in ra API_URL và SERVICE_ROLE_KEY
# Dùng bản hosted: supabase.com/dashboard → Project Settings → API keys
SUPABASE_URL=https://<project-ref>.supabase.co

# ⚠ KHOÁ NÀY BỎ QUA TOÀN BỘ ROW LEVEL SECURITY — không bao giờ đưa lên client,
#   không commit vào git, không dán vào chat. Tên biến cố tình KHÔNG có tiền tố
#   `PUBLIC_` vì Astro chỉ đưa biến `PUBLIC_*` vào bundle trình duyệt.
#
#   Cũng KHÔNG đặt nó vào GitHub Actions: CI dùng `build:ci` nên không cần
#   database. Bí mật không tồn tại ở đó là bí mật không thể rò rỉ ở đó.
#
#   Định dạng mới `sb_secret_...` còn tự chặn: gọi API với User-Agent trông như
#   trình duyệt thì Supabase trả 401 "Forbidden use of secret API key in browser".
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
#  Đếm lượt xem (tuỳ chọn nhưng nên bật)
#
#  Hai biến này CỐ Ý công khai — chúng đi vào bundle trình duyệt. Đó là đúng
#  thiết kế của khoá anon: Row Level Security mới là thứ bảo vệ dữ liệu, không
#  phải sự bí mật của khoá.
#
#  Với khoá này khách chỉ làm được hai việc: đọc bài ĐÃ ĐĂNG, và gọi đúng một
#  hàm `tang_luot_xem()` để cộng 1 lượt cho một slug có thật. Không ghi trực
#  tiếp vào bảng nào được — đã kiểm: trả về lỗi 42501.
#
#  Thiếu hai biến này thì phần đếm lượt xem tự tắt, site vẫn chạy bình thường.
# ---------------------------------------------------------------------------
#  `PUBLIC_SUPABASE_URL` còn dùng cho một việc thứ hai: `astro.config.ts` suy ra
#  host Supabase Storage từ nó để cho phép tối ưu ảnh bìa remote. Bỏ trống thì
#  ảnh từ Storage bị build từ chối với lỗi `RemoteImageNotAllowed`.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# ===========================================================================
#  TÍNH NĂNG TUỲ CHỌN
#  Thiếu biến nào thì tính năng đó tự tắt, site vẫn build và chạy bình thường.
# ===========================================================================

# --- Thống kê: Umami (https://umami.is — cloud free 100k lượt xem/tháng) ---
# Bỏ trống ở môi trường dev để không làm bẩn số liệu.
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# --- Bình luận: giscus (dùng GitHub Discussions, miễn phí) ---
#
# KHÔNG cần vào giscus.app copy tay. Chạy lệnh này, nó in ra đúng bốn dòng dưới:
#
#     pnpm giscus:setup <chu-so-huu>/<ten-repo>
#
# Repo phải: (1) public, (2) đã bật Discussions trong Settings → Features,
# (3) đã cài app https://github.com/apps/giscus. Thiếu cái nào script cũng nói rõ.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# --- Newsletter ---
#
# Hai chế độ, khối đăng ký tự chọn theo thứ tự ưu tiên dưới đây:
#
#  1. CÓ biến này  →  chế độ `provider`: form POST thẳng tới nhà cung cấp.
#     Họ lo gửi thư, xác nhận, huỷ đăng ký và khả năng vào được inbox.
#     Chạy được cả khi người đọc tắt JavaScript. ĐÂY LÀ LỰA CHỌN NÊN DÙNG.
#     Buttondown: https://buttondown.email/api/emails/embed-subscribe/<username>
#
#  2. BỎ TRỐNG    →  chế độ `supabase`: lưu email vào database của chính bạn.
#     Chạy được ngay, không cần tài khoản ngoài. Xem danh sách đã thu:
#     pnpm db:subscribers
PUBLIC_NEWSLETTER_ACTION=

# --- Gửi thư newsletter: Resend (chỉ cần cho chế độ `supabase` ở trên) ---
#
# Hai biến này CHỈ dùng bởi `scripts/newsletter-send.mjs`, chạy Ở MÁY. Chúng không
# có tiền tố PUBLIC_ nên Astro không đưa vào bundle, và cũng KHÔNG đặt vào GitHub
# Actions — gửi bản tin là việc làm tay khi có bài mới, không phải việc của CI.
#
#   1. Tạo tài khoản https://resend.com — bậc free 3.000 thư/tháng, 100 thư/ngày
#   2. Domains → thêm và xác minh tên miền gửi (cần thêm bản ghi DNS).
#      Chưa có tên miền thì dùng onboarding@resend.dev để thử, nhưng nó CHỈ gửi
#      được tới chính email đã đăng ký Resend.
#   3. API Keys → Create → quyền "Sending access" là đủ
#
# Gửi:
#   pnpm newsletter:xac-nhan              chạy thử
#   pnpm newsletter:xac-nhan --that       gửi thật
#   pnpm newsletter:gui --bai=<slug>      chạy thử
#   pnpm newsletter:gui --bai=<slug> --that
RESEND_API_KEY=
NEWSLETTER_FROM=
